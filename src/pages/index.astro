---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import HomeServiceAreas from '../components/HomeServiceAreas.astro';
import About from '../components/About.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import GoogleRatingCard from '../components/GoogleRatingCard.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import HomeIntro from '../components/HomeIntro.astro';
import { homeFaqs } from '../data/home-faq';
import { CANONICAL_BASE } from '../config';
import { optimizedImageW, srcsetImage } from '../lib/cloudinary';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="İstanbul İç Mimarlık, Tadilat ve Dekorasyon"
  description="İstanbul'da iç mimarlık, anahtar teslim ev ve villa tadilatı, ofis, mağaza ve cafe yenileme. Ücretsiz keşif ve 3D tasarım. 0533 039 15 65"
  structuredData={faqSchema}
  canonicalUrl={`${CANONICAL_BASE}/`}
  lcpImage={optimizedImageW('/images/salon1.png', 800)}
  lcpImageSrcset={srcsetImage('/images/salon1.png', [400, 800, 1200, 1920])}
  lcpImageSizes="100vw"
>
  <Header />
  <main>
    <Hero />
    <Projects />
    {/*
    About: metni hakkimizda.astro ile birebir aynı — açılırsa kopya içerik olur.

    BeforeAfter: şimdilik kapalı, sonra açılabilir. Bileşen ARTIK ÇALIŞIR durumda:
    görsel yolları /images/beforeafter/ → /beforeafter/ olarak düzeltildi ve
    villaoncesi.HEIC (tarayıcıda açılmayan format) JPG'ye dönüştürüldü.
    İçerik gerçek: Beyoğlu Galata, Beykoz Paşabahçe ve Ataköy projelerinin
    öncesi/sonrası fotoğrafları. Görseller data-bg + IntersectionObserver ile
    tembel yükleniyor, LCP'yi etkilemiyor.
    Açmadan önce: public/beforeafter/ git'e eklenmeli, yoksa Cloudinary fetch
    404 alır ve bölüm boş görünür.
    <About />
    <BeforeAfter />
    */}
    <Services />
    <HomeIntro />
    <HomeServiceAreas />
    <Contact />
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
