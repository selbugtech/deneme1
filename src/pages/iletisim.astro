---
import ServiceLayout from '../layouts/ServiceLayout.astro';
import {
  CANONICAL_BASE, SITE_NAME, SITE_PHONE, SITE_PHONE_DISPLAY,
  TEL_URL, EMAIL, EMAIL_URL, WHATSAPP_URL_WITH_MESSAGE, GOOGLE_MAPS_URL, GOOGLE_MAPS_EMBED_URL,
} from '../config';
import { optimizedImage } from '../lib/cloudinary';
import { districts } from '../data/districts';

const heroPath = '/images/salon4.jpeg';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Master İç Mimarlık İletişim",
  "url": `${CANONICAL_BASE}/iletisim`,
  "description": "Master İç Mimarlık iletişim bilgileri: telefon, WhatsApp, e-posta, ofis adresi ve çalışma saatleri.",
  "mainEntity": { "@id": `${CANONICAL_BASE}/#business` },
};

const localSchema = {
  "@context": "https://schema.org",
  "@type": "InteriorDesigner",
  "@id": `${CANONICAL_BASE}/#business`,
  "name": SITE_NAME,
  "url": `${CANONICAL_BASE}/iletisim`,
  "telephone": SITE_PHONE,
  "email": EMAIL,
  "image": optimizedImage(heroPath),
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Akasya A Kule, No: 25/A, Çeçen Sok., Acıbadem",
    "addressLocality": "Üsküdar",
    "addressRegion": "İstanbul",
    "postalCode": "34660",
    "addressCountry": "TR",
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 41.001739, "longitude": 29.0543556 },
  "hasMap": GOOGLE_MAPS_URL,
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "19:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "17:00" },
  ],
  "areaServed": { "@type": "City", "name": "İstanbul" },
};

const faqItems = [
  {
    q: "Ücretsiz keşif randevusunu nasıl alabilirim?",
    a: "0533 039 15 65 numarasını arayarak ya da WhatsApp'tan yazarak randevu alabilirsiniz. Hafta içi 09:00–19:00, Cumartesi 10:00–17:00 saatleri arasında dönüş yapıyoruz. Mesai dışında bıraktığınız mesajlara ertesi iş günü ilk saatlerde yanıt veriyoruz.",
  },
  {
    q: "Keşif ziyareti gerçekten ücretsiz mi?",
    a: "Evet. Keşif ziyareti tamamen ücretsizdir ve hiçbir yükümlülük doğurmaz. Ziyarette mekanı yerinde inceliyor, ölçü alıyor ve ihtiyacınızı dinliyoruz. Teklifimizi inceleyip karar verme süresi tamamen size aittir.",
  },
  {
    q: "Ofisinize gelmem gerekiyor mu?",
    a: "Gerekmiyor. Süreç genellikle sizin mekanınızda yapılan keşifle başlar. Yine de malzeme ve numune seçimi için ofisimizde görüşmeyi tercih ederseniz Acıbadem'deki ofisimize randevuyla gelebilirsiniz.",
  },
  {
    q: "İstanbul dışından ulaşabilir miyim?",
    a: "Ana hizmet bölgemiz İstanbul olmakla birlikte büyük ölçekli projelerde çevre illere de gidiyoruz. Şehir dışında veya yurt dışındaysanız süreci video görüşmeleri, fotoğraf ve video ilerleme raporlarıyla uzaktan yürütebiliyoruz.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const socials = [
  { label: 'Instagram', href: 'https://www.instagram.com/mastericmimarlik/' },
  { label: 'Facebook', href: 'https://www.facebook.com/master.mmrlk' },
  { label: 'Pinterest', href: 'https://tr.pinterest.com/mastericmimarlik/' },
  { label: 'YouTube', href: 'https://www.youtube.com/channel/UC1vs1O0VUe_VNZIpo8B1KzA' },
  { label: 'X', href: 'https://x.com/mastericmimar' },
];
---

<ServiceLayout
  title="İletişim — Master İç Mimarlık İstanbul"
  description="Master İç Mimarlık iletişim: telefon, WhatsApp, e-posta ve Acıbadem ofis adresi. Ücretsiz keşif randevusu için 0533 039 15 65"
  canonicalUrl={`${CANONICAL_BASE}/iletisim`}
  h1="İletişim"
  eyebrow="Bize Ulaşın"
  lead="Projenizi konuşalım. Ücretsiz keşif randevusu için telefon veya WhatsApp yeterli — mekanınızı yerinde görüp size özel teklifimizi hazırlayalım."
  heroImage={heroPath}
  ogImage={optimizedImage(heroPath)}
  expandedByDefault={true}
  contactShowMap={false}
  breadcrumb={[
    { label: "Ana Sayfa", href: `${CANONICAL_BASE}/` },
    { label: "İletişim" }
  ]}
  structuredData={[contactSchema, localSchema, faqSchema]}
>

  <!-- Kanallar -->
  <section class="py-12 border-b border-border">
    <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Nasıl Ulaşabilirsiniz?</h2>
    <p class="text-muted leading-relaxed max-w-3xl mb-8">
      En hızlı yanıtı WhatsApp üzerinden alırsınız. Mekanınızın birkaç fotoğrafını ve yaklaşık metrekaresini
      paylaşırsanız, keşiften önce bile süreç hakkında net bir çerçeve çizebiliriz.
    </p>
    <div class="grid md:grid-cols-3 gap-4">
      <a href={WHATSAPP_URL_WITH_MESSAGE} target="_blank" rel="noopener noreferrer"
         class="group border border-border p-6 hover:border-gold transition-colors duration-200 block">
        <p class="text-[10px] tracking-[0.25em] uppercase text-gold mb-2">En hızlı yanıt</p>
        <h3 class="font-display text-lg font-bold text-charcoal mb-1 group-hover:text-gold transition-colors">WhatsApp'tan Yazın</h3>
        <p class="text-muted text-sm">Fotoğraf ve ölçü paylaşarak başlayın</p>
      </a>
      <a href={TEL_URL} class="group border border-border p-6 hover:border-gold transition-colors duration-200 block">
        <p class="text-[10px] tracking-[0.25em] uppercase text-gold mb-2">Telefon</p>
        <h3 class="font-display text-lg font-bold text-charcoal mb-1 group-hover:text-gold transition-colors">{SITE_PHONE_DISPLAY}</h3>
        <p class="text-muted text-sm">Ücretsiz keşif için hemen arayın</p>
      </a>
      <a href={EMAIL_URL} class="group border border-border p-6 hover:border-gold transition-colors duration-200 block">
        <p class="text-[10px] tracking-[0.25em] uppercase text-gold mb-2">E-posta</p>
        <h3 class="font-display text-lg font-bold text-charcoal mb-1 group-hover:text-gold transition-colors break-all">{EMAIL}</h3>
        <p class="text-muted text-sm">Detaylı proje dosyaları için</p>
      </a>
    </div>
  </section>

  <!-- Adres, saatler, harita -->
  <section class="py-12 border-b border-border">
    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-3xl font-bold text-charcoal mb-6">Ofisimiz</h2>

        <h3 class="font-semibold text-charcoal mb-2">Adres</h3>
        <p class="text-muted leading-relaxed mb-6">
          Akasya A Kule, No: 25/A<br />
          Çeçen Sok., Acıbadem<br />
          34660 Üsküdar / İstanbul
        </p>

        <h3 class="font-semibold text-charcoal mb-2">Çalışma Saatleri</h3>
        <ul class="text-muted text-sm space-y-1 mb-6">
          <li>Pazartesi – Cuma · 09:00 – 19:00</li>
          <li>Cumartesi · 10:00 – 17:00</li>
          <li>Pazar · Kapalı</li>
        </ul>

        <h3 class="font-semibold text-charcoal mb-2">Bizi Takip Edin</h3>
        <div class="flex flex-wrap gap-3 mb-6">
          {socials.map(s => (
            <a href={s.href} target="_blank" rel="noopener noreferrer"
               class="px-4 py-2 border border-border text-sm text-charcoal hover:border-gold hover:text-gold transition-colors">
              {s.label}
            </a>
          ))}
        </div>

        <a href={GOOGLE_MAPS_URL} target="_blank" rel="noopener noreferrer" class="text-sm text-gold hover:underline">
          Google Haritalar'da aç →
        </a>
      </div>

      <div>
        <div class="border border-border overflow-hidden">
          <iframe
            src={GOOGLE_MAPS_EMBED_URL}
            width="100%"
            height="420"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Master İç Mimarlık ofis konumu — Acıbadem, Üsküdar"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Keşiften önce -->
  <section class="py-12 border-b border-border">
    <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Keşiften Önce Hazırlamanız İyi Olanlar</h2>
    <p class="text-muted leading-relaxed max-w-3xl mb-6">
      Keşif için hazırlık şart değil, ama aşağıdakiler elinizde olursa ilk görüşmede çok daha net konuşabiliriz.
      Hiçbiri yoksa da sorun değil — ölçüyü biz alırız.
    </p>
    <div class="grid md:grid-cols-2 gap-x-12 gap-y-3">
      {[
        'Varsa dairenin kat planı veya tapu krokisi',
        'Mekanın mevcut halini gösteren birkaç fotoğraf',
        'Beğendiğiniz görsellerden oluşan bir referans klasörü',
        'Taşınma veya kullanım için hedeflediğiniz tarih',
        'Elektrik ve tesisatta bildiğiniz sorunlar',
        'Yönetim planında tadilat için bir kısıt olup olmadığı',
      ].map(item => (
        <div class="flex items-start gap-3 text-sm text-muted">
          <span class="w-4 h-4 mt-0.5 shrink-0 bg-gold/15 rounded-full flex items-center justify-center">
            <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
            </svg>
          </span>
          {item}
        </div>
      ))}
    </div>
  </section>

  <!-- Bölgeler -->
  <section class="py-12 border-b border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-4">Hizmet Bölgelerimiz</h2>
    <p class="text-muted leading-relaxed max-w-3xl mb-6">
      Ofisimiz Acıbadem'de; keşif için İstanbul'un iki yakasına da gidiyoruz. Bulunduğunuz ilçedeki çalışma
      notlarımızı ilgili sayfadan okuyabilirsiniz.
    </p>
    <div class="flex flex-wrap gap-2">
      {districts.map(d => (
        <a href={`/istanbul/${d.slug}`} class="px-4 py-2 border border-border text-sm text-charcoal hover:border-gold hover:text-gold transition-colors">
          {d.name}
        </a>
      ))}
    </div>
  </section>

  <!-- SSS -->
  <section class="py-12">
    <h2 class="font-display text-3xl font-bold text-charcoal mb-8">İletişim ve keşif hakkında</h2>
    <div class="space-y-4">
      {faqItems.map(f => (
        <details class="border border-border bg-[#FAF6F1] p-6 group">
          <summary class="font-semibold text-charcoal cursor-pointer list-none flex items-start justify-between gap-4">
            <span>{f.q}</span>
            <span class="text-gold shrink-0 transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="text-muted text-sm leading-relaxed mt-4">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

</ServiceLayout>
