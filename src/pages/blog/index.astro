---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { CANONICAL_BASE } from '../../config';
import { allPosts } from '../../data/blog-posts';

const posts = allPosts;

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Ana Sayfa", "item": `${CANONICAL_BASE}/` },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${CANONICAL_BASE}/blog` }
  ]
};
---

<Layout
  title="Blog | İç Mimarlık ve Ev Yenileme Rehberi"
  description="İstanbul'da ev yenileme maliyetleri, iç mimarlık trendleri, oda bazlı dekorasyon fikirleri ve ilçe ilçe tadilat rehberleri. Master İç Mimarlık blogu."
  canonicalUrl={`${CANONICAL_BASE}/blog`}
  structuredData={breadcrumbSchema}
>
  <Header />

  <main class="min-h-screen" style="background-color: #EDE5D8;">

    <!-- Navbar arkası siyah header bandı -->
    <div class="bg-charcoal pt-24">
      <div class="max-w-4xl mx-auto px-6 pt-10 pb-14">
        <nav class="flex items-center gap-2 mb-8 text-sm" aria-label="Breadcrumb">
          <a href="/" class="text-white/50 hover:text-gold transition-colors">Ana Sayfa</a>
          <span class="text-white/20">/</span>
          <span class="text-white/70">Blog</span>
        </nav>
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-px bg-gold"></span>
          <span class="text-xs tracking-[0.3em] uppercase text-gold font-medium">Blog</span>
        </div>
        <h1 class="font-display text-4xl md:text-5xl font-bold text-white leading-tight mb-4">
          İç Mimarlık &<br />
          <em class="not-italic text-gold">Ev Yenileme</em> Rehberi
        </h1>
        <p class="text-white/60 leading-relaxed max-w-xl">
          İstanbul'da ev yenileme, iç mimarlık trendleri ve tadilat süreçleri hakkında uzman içerikler.
        </p>
      </div>
    </div>

    <!-- Blog listesi -->
    <div class="max-w-4xl mx-auto px-6 py-16">
      <div class="space-y-8">
        {posts.map((post) => (
          <a href={`/blog/${post.slug}`} class="group block border border-[#d6cdc2] p-8 hover:border-gold transition-colors duration-200" style="background-color: #F5EFE6;">
            <div class="flex items-center gap-4 mb-4">
              <span class="text-[10px] tracking-[0.25em] uppercase text-gold font-medium">{post.tag}</span>
              <span class="text-border">·</span>
              <time class="text-xs text-muted" datetime={post.date}>
                {new Date(post.date).toLocaleDateString('tr-TR', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
              <span class="text-border">·</span>
              <span class="text-xs text-muted">{post.readingTime} okuma</span>
            </div>
            <h2 class="font-display text-2xl font-bold text-charcoal mb-3 group-hover:text-gold transition-colors">{post.title}</h2>
            <p class="text-muted leading-relaxed text-sm mb-4">{post.excerpt}</p>
            <span class="text-xs text-gold inline-flex items-center gap-1.5">
              Devamını oku
              <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>

  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>
