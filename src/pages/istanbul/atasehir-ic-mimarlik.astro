---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import RelatedDistricts from '../../components/RelatedDistricts.astro';
import DistrictBlogLinks from '../../components/DistrictBlogLinks.astro';
import DistrictFAQ from '../../components/DistrictFAQ.astro';
import ProcessStrip from '../../components/ProcessStrip.astro';
import DistrictProjects from '../../components/DistrictProjects.astro';
import { CANONICAL_BASE } from '../../config';
import { optimizedImageW, ogImageUrl } from '../../lib/images';
import { getDistrict } from '../../data/districts';

// İlçe adı ve bulunma hali eki tek kaynaktan: src/data/districts.ts.
// Elle yazılan ek Türkçe'de sessizce yanlış olabiliyor (Bağcılar'de → Bağcılar'da).
const district = getDistrict('atasehir-ic-mimarlik')!;
const heroPath = '/images/salon8.jpeg';
const heroAbs = ogImageUrl(heroPath);

const localSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "İç mimarlık, tadilat ve ev yenileme",
  "provider": { "@id": `${CANONICAL_BASE}/#business` },
  "areaServed": { "@type": "Place", "name": "Ataşehir, İstanbul" },
  "url": `${CANONICAL_BASE}/istanbul/atasehir-ic-mimarlik`,
  "description": "Ataşehir ve çevresinde rezidans, site dairesi ve villa yenileme; anahtar teslim iç mimarlık hizmetleri.",
  "image": heroAbs,
};

const faqItems = [
  {
    q: "Ataşehir'de iç mimarlık ve daire yenileme ne kadar sürer?",
    a: "Ataşehir'deki tipik 2+1 ve 3+1 dairelerde anahtar teslim yenileme 4–8 hafta, lüks rezidans ve büyük dairelerde 6–10 hafta sürmektedir. Site yönetimi onay süreçlerini de biz takip ediyoruz.",
  },
  {
    q: "Ataşehir'de hangi mahalle ve sitelerde hizmet veriyorsunuz?",
    a: "Barbaros, Atatürk, Yenisahra, İçerenköy, Küçükbakkalköy, Kayışdağı, Mustafa Kemal ve Fetih Mahallesi başta olmak üzere Ataşehir genelinde aktif çalışıyoruz. Bölgedeki yeni nesil rezidans projelerinde site içi koordinasyon ve hızlı uygulama deneyimimiz güçlü.",
  },
  {
    q: "Ataşehir'de site yönetimi tadilat için ne istiyor, yazışmaları kim yürütüyor?",
    a: "Siteden siteye değişmekle birlikte yönetimler genellikle yazılı bilgilendirme, ekip listesi ve çalışma saati taahhüdü istiyor; asansör ve ortak alanların korunması da şart koşuluyor. Şantiye takvimini bu kurallara göre kuruyor, gerekli yönetim yazışmalarını sizin adınıza yürütüyoruz.",
  },
  {
    q: "Ofis veya ticari alan yenilerken günlük iş akışı ne kadar etkilenir?",
    a: "Ataşehir'in iş merkezi dokusu nedeniyle ofis yenilemelerinde çalışma düzeni önemli bir kriter. Mesai sonrası veya hafta sonu çalışma, bölümlere ayırarak aşamalı ilerleme gibi seçenekleri keşifte birlikte değerlendiriyor, bina yönetiminin saat kurallarına göre takvimi çıkarıyoruz.",
  },
  {
    q: "Ataşehir'de bir site dairesi için nasıl bir yenileme önerirsiniz?",
    a: "Planlı site dairelerinde en sık çalıştığımız kalemler depolama kapasitesini artırmak, mutfak dolabı kurgusunu yeniden ele almak ve salonu gerçek kullanıma göre düzenlemek. Keşifte dairenizin plan şemasına en yakın çalışmalarımızı gösteriyor, tamamladığımız işleri projeler sayfamızda da paylaşıyoruz.",
  },
];
---

<ServiceLayout
  title="Ataşehir İç Mimarlık, Ev Tadilatı ve Dekorasyon"
  description="Ataşehir'de iç mimarlık, site dairesi yenileme ve mutfak-banyo tadilatı. Barbaros, Yenisahra ve İçerenköy'de aktif. Ücretsiz keşif: 0533 039 15 65"
  canonicalUrl={`${CANONICAL_BASE}/istanbul/atasehir-ic-mimarlik`}
  h1="Ataşehir İç Mimarlık, Ev Tadilatı ve Dekorasyon"
  eyebrow="İstanbul · Ataşehir"
  lead="Ataşehir'in modern rezidans ve konut projelerine uygun, çağdaş ve yaşanabilir iç mekan tasarımları sunuyoruz. Anadolu yakasının hızla gelişen bu ilçesinde tadilat ve dekorasyonu baştan sona yönetiyoruz."
  heroImage={heroPath}
  breadcrumb={[
    { label: "Ana Sayfa", href: `${CANONICAL_BASE}/` },
    { label: "İstanbul", href: `${CANONICAL_BASE}/istanbul` },
    { label: "Ataşehir" }
  ]}
  structuredData={localSchema}
>

  <div class="grid md:grid-cols-2 gap-12 py-12 border-b border-border">
    <div>
      <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Ataşehir'de İç Mimarlık</h2>
      <p class="text-muted leading-relaxed mb-4">
        Ataşehir; İstanbul'un Anadolu yakasında hızla gelişen, modern rezidans kompleksleri ve yeni nesil konut projelerine ev sahipliği yapan dinamik bir ilçedir. Bölgedeki yeni yapı stoku, yüksek standartlarda iç mekan beklentisi getiriyor ve tasarımı bu çıtaya göre kuruyoruz.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Ataşehir'in yapı stoku ağırlıklı olarak planlı site dairelerinden oluşuyor. Bu dairelerde yönetim koordinasyonunu, hafta sonu çalışma kısıtlarını ve asansör-zemin koruma kurallarını biz yönetiyoruz; uygulama takvimini site yönetiminin izin verdiği saatlere göre çıkarıyoruz.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Aynı sitede çok sayıda daire benzer planla ve benzer malzeme paketiyle teslim edilebildiği için Ataşehir'de asıl mesele standart planı kişiselleştirmek. Dolap ve depolama kurgusu, mutfak düzeni ve aydınlatma gibi dekorasyon kararlarıyla daireyi hanenin gerçek kullanımına uyarlıyor; çalışma saatleri ve ortak alan kuralları gibi site koşullarını da tadilat planına baştan dahil ediyoruz.
      </p>
      <p class="text-muted leading-relaxed">
        Barbaros, Atatürk, Yenisahra, İçerenköy, Küçükbakkalköy, Kayışdağı, Mustafa Kemal ve Fetih başta olmak üzere Ataşehir genelinde hizmet veriyoruz.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-charcoal mb-4">{district.locative} Sunduğumuz Hizmetler</h3>
      <ul class="space-y-3">
        {[
          'Anahtar teslim daire yenileme',
          'Rezidans iç mimarlığı',
          'Mutfak ve banyo tadilatı',
          'Salon, yatak odası ve giyinme odası tasarımı',
          '3D görselleştirme ile tasarım onayı',
          'Site dairelerinde hızlı uygulama yönetimi',
        ].map(item => (
          <li class="flex items-start gap-3 text-sm text-muted">
            <span class="w-4 h-4 mt-0.5 shrink-0 bg-gold/15 rounded-full flex items-center justify-center">
              <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bölge notları -->
  <section class="py-12 border-b border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">{district.locative} Bölge Notlarımız</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Barbaros · Atatürk Mahallesi</h3>
        <p class="text-muted text-sm leading-relaxed">
          İş merkezleri ve rezidansların yakın durduğu hat. Konutta yönetim kuralları, ofis tarafında ise çalışma düzeni takvimi belirliyor; mesai dışı çalışma seçenekleri keşifte değerlendiriliyor.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Yenisahra</h3>
        <p class="text-muted text-sm leading-relaxed">
          Planlı site yerleşimlerinin yoğun olduğu bölge. Dairelerin planı çoğunlukla standart olduğu için depolama, mutfak ve salon kurgusunda kişiselleştirme en çok fark yaratan kalemler.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">İçerenköy</h3>
        <p class="text-muted text-sm leading-relaxed">
          Daha yerleşik, karma yapı stoku. Binanın yaşına göre tesisat ve elektrik kontrolünü keşifte yapıyor, tadilat kapsamını sökümden sonra netleştiriyoruz.
        </p>
      </div>
    </div>
  </section>

  <DistrictProjects districtSlug="atasehir-ic-mimarlik" />

  <ProcessStrip districtSlug="atasehir-ic-mimarlik" />

  <DistrictFAQ districtName="Ataşehir" items={faqItems} />

  <div class="py-12 border-t border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Diğer Hizmetlerimiz</h2>
    <div class="flex flex-wrap gap-3">
      {[
        { label: 'Anahtar Teslim Hizmetler', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim` },
        { label: 'Villa Yenileme', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim/villa-yenileme` },
        { label: 'Ofis Yenileme', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim/ofis-yenileme` },
        { label: '3D Tasarım', href: `${CANONICAL_BASE}/hizmetler/3d-tasarim` },
        { label: 'Ev Tadilatı', href: '/hizmetler/anahtar-teslim/ev-tadilat' },
        { label: 'Ofis Tadilatı', href: '/hizmetler/anahtar-teslim/ofis-tadilat' },
        { label: 'Mutfak Yenileme', href: '/hizmetler/mutfak-yenileme' },
        { label: 'Ataşehir Ev Tadilatı Rehberi', href: '/blog/atasehir-ev-tadilati' },
        { label: 'Kadıköy İç Mimarlık', href: '/istanbul/kadikoy-ic-mimarlik' },
      ].map(l => (
        <a href={l.href} class="px-4 py-2 border border-border text-sm text-charcoal hover:border-gold hover:text-gold transition-colors">{l.label}</a>
      ))}
    </div>
  </div>

  <DistrictBlogLinks districtSlug="atasehir-ic-mimarlik" />

  <RelatedDistricts currentSlug="atasehir-ic-mimarlik" />

</ServiceLayout>
