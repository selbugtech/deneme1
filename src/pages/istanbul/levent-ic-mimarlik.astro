---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import RelatedDistricts from '../../components/RelatedDistricts.astro';
import DistrictBlogLinks from '../../components/DistrictBlogLinks.astro';
import DistrictFAQ from '../../components/DistrictFAQ.astro';
import ProcessStrip from '../../components/ProcessStrip.astro';
import DistrictProjects from '../../components/DistrictProjects.astro';
import { CANONICAL_BASE } from '../../config';
import { optimizedImageW } from '../../lib/cloudinary';
import { getDistrict } from '../../data/districts';

// İlçe adı ve bulunma hali eki tek kaynaktan: src/data/districts.ts.
// Elle yazılan ek Türkçe'de sessizce yanlış olabiliyor (Bağcılar'de → Bağcılar'da).
const district = getDistrict('levent-ic-mimarlik')!;
const heroPath = '/images/ofis2.jpeg';
const heroAbs = optimizedImageW(heroPath, 1600);

const localSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "İç mimarlık, tadilat ve ev yenileme",
  "provider": { "@id": `${CANONICAL_BASE}/#business` },
  "areaServed": { "@type": "Place", "name": "Levent, İstanbul" },
  "url": `${CANONICAL_BASE}/istanbul/levent-ic-mimarlik`,
  "description": "Levent ve çevresinde lüks rezidans iç mimarlığı, kurumsal ofis yenileme ve anahtar teslim daire tadilatı.",
  "image": heroAbs,
};

const faqItems = [
  {
    q: "Levent'te ofis yenileme ve daire tadilatı ne kadar sürer?",
    a: "Levent'teki orta ölçek daire yenilemeleri 5–8 hafta, lüks rezidans projeleri 6–10 hafta ve 200–400 m² kurumsal ofis yenilemeleri 6–12 hafta sürmektedir. Ofis projelerinde mesai sonrası ve hafta sonu çalışma planı yaparak iş kesintisini en aza indiriyoruz.",
  },
  {
    q: "Levent'te hangi mahalle ve plazalarda hizmet veriyorsunuz?",
    a: "1. Levent, 4. Levent, Sanayi Mahallesi, Çırağan, Etiler sınırı ve Maslak sınırındaki plazalar dahil bölgenin tamamında çalışıyoruz. Levent ofis kuleleri ve lüks rezidanslar için hem kurumsal hem konut deneyimimiz güçlüdür.",
  },
  {
    q: "Plazadaki ofis katında tadilat için bina yönetiminden neler isteniyor?",
    a: "Plaza yönetimleri genellikle çalışma saatlerini, yük asansörü randevusunu, ekip giriş-çıkış listesini ve ortak alan koruma önlemlerini önceden yazılı olarak istiyor. Bu başlıkların çoğu ofis tadilatında takvimi doğrudan belirlediği için, yönetim yazışmalarını ve randevu planını işe başlamadan önce tamamlıyoruz.",
  },
  {
    q: "Levent'te rezidans dairesi tadilatında komşu ve kat mülkiyeti süreci nasıl işler?",
    a: "Kat mülkiyeti olan binalarda yönetim planındaki kurallar geçerli; gürültülü çalışma saatleri ve ortak alan kullanımı çoğunlukla sınırlı. Komşuları önceden bilgilendirmek, itirazları ve şikayetleri azaltan en pratik adım. Şantiye takvimini bu kurallara göre çıkarıyor, gereken yönetim yazışmalarını sizin adınıza yürütüyoruz.",
  },
  {
    q: "Levent'te hem ofis hem ev için tek ekiple çalışmak mümkün mü?",
    a: "Evet. Ofis ve konut işlerinde farklı önceliklerle, ancak aynı tasarım ve uygulama ekibiyle ilerliyoruz. Ofiste akustik, aydınlatma ve çalışma akışı; evde depolama ve günlük kullanım öne çıkıyor. Tamamladığımız işleri projeler sayfamızda inceleyebilir, keşifte mekan tipinize en yakın örnekleri görebilirsiniz.",
  },
];
---

<ServiceLayout
  title="Levent İç Mimarlık, Ev ve Ofis Tadilatı"
  description="Levent'te iç mimarlık, ev ve ofis tadilatı, rezidans yenileme. 1. Levent, 4. Levent, Gültepe ve Sanayi Mahallesi'nde aktif. Ücretsiz keşif: 0533 039 15 65"
  canonicalUrl={`${CANONICAL_BASE}/istanbul/levent-ic-mimarlik`}
  h1="Levent İç Mimarlık, Ev ve Ofis Tadilatı"
  eyebrow="İstanbul · Levent"
  lead="Levent'in kurumsal ve lüks konut dokusuna uygun, hem ev hem ofis yenileme projelerinde deneyimli ekibimizle hizmetinizdeyiz. Plaza ofisleri, lüks rezidanslar ve klasik daireler için tadilat ve dekorasyon süreçlerini baştan sona yönetiyoruz."
  heroImage={heroPath}
  breadcrumb={[
    { label: "Ana Sayfa", href: `${CANONICAL_BASE}/` },
    { label: "İstanbul", href: `${CANONICAL_BASE}/istanbul` },
    { label: "Levent" }
  ]}
  structuredData={localSchema}
>

  <div class="grid md:grid-cols-2 gap-12 py-12 border-b border-border">
    <div>
      <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Levent'te İç Mimarlık ve Yenileme</h2>
      <p class="text-muted leading-relaxed mb-4">
        Levent; İstanbul'un finans ve iş merkezi olmasının yanı sıra, üst gelir grubuna hitap eden lüks rezidans ve konutlarıyla da öne çıkan bir semttir. Bu yapı, hem kurumsal ofis projelerinde hem de lüks ev yenilemelerinde uzmanlaşmamızı gerektirdi.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Levent'te plaza ofisleri ve rezidans daireleri iki ayrı çalışma biçimi gerektiriyor. Ofis tarafında bina yönetiminin çalışma saatleri ve asansör kullanımı planı baştan kuruluyor; konut tarafında ise kat mülkiyeti kuralları ve komşu bildirimi süreci belirleyici oluyor. Her iki durumda da uygulama takvimini bu kısıtlara göre çıkarıyoruz.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Levent'te dekorasyon tercihleri de kullanım türüne göre ayrışıyor. Ofiste akustik, aydınlatma ve marka kimliği; evde ise depolama, ışık ve günlük kullanım kolaylığı öne çıkıyor. İki durumda da tadilata başlamadan önce 3D görselleştirmeyle mekanı birlikte gözden geçirmek, uygulama sırasındaki değişiklik ihtiyacını çoğunlukla azaltıyor.
      </p>
      <p class="text-muted leading-relaxed">
        1. Levent, 4. Levent, Sanayi Mahallesi, Çırağan, Etiler sınırı ve Maslak sınırı başta olmak üzere Levent ve çevresinde aktif olarak hizmet veriyoruz.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-charcoal mb-4">{district.locative} Sunduğumuz Hizmetler</h3>
      <ul class="space-y-3">
        {[
          'Kurumsal ofis yenileme',
          'Lüks konut iç mimarlığı',
          'Anahtar teslim ev yenileme',
          'Toplantı odası ve lobi tasarımı',
          'Açık ofis ve çalışma alanı planlaması',
          '3D görselleştirme ve proje',
        ].map(item => (
          <li class="flex items-start gap-3 text-sm text-muted">
            <span class="w-4 h-4 mt-0.5 shrink-0 bg-gold/15 rounded-full flex items-center justify-center">
              <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bölge notları -->
  <section class="py-12 border-b border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">{district.locative} Bölge Notlarımız</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">1. Levent · 4. Levent</h3>
        <p class="text-muted text-sm leading-relaxed">
          Plaza ve rezidans yoğunluğunun en fazla olduğu çekirdek hat. Bina yönetiminin çalışma saati, yük asansörü ve giriş-çıkış kuralları şantiye takvimini belirliyor.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Gültepe</h3>
        <p class="text-muted text-sm leading-relaxed">
          Konut ağırlıklı, daha yerleşik bir çevre. Binanın yaşına göre tesisat ve elektrik kontrolü yapılıyor; mutfak, banyo ve depolama güncellemesi sık gündeme geliyor.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Sanayi Mahallesi</h3>
        <p class="text-muted text-sm leading-relaxed">
          Ofis ve ticari kullanımın öne çıktığı karma bir çevre. Keşifte önce binanın kullanım türünü ve yönetim kurallarını netleştiriyor, tadilat planını bu çerçevede kuruyoruz.
        </p>
      </div>
    </div>
  </section>

  <DistrictProjects districtSlug="levent-ic-mimarlik" />

  <ProcessStrip districtSlug="levent-ic-mimarlik" />

  <DistrictFAQ districtName="Levent" items={faqItems} />

  <div class="py-12 border-t border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Diğer Hizmetlerimiz</h2>
    <div class="flex flex-wrap gap-3">
      {[
        { label: 'Anahtar Teslim Hizmetler', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim` },
        { label: 'Villa Yenileme', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim/villa-yenileme` },
        { label: 'Ofis Yenileme', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim/ofis-yenileme` },
        { label: '3D Tasarım', href: `${CANONICAL_BASE}/hizmetler/3d-tasarim` },
        { label: 'Ofis Tadilatı', href: '/hizmetler/anahtar-teslim/ofis-tadilat' },
        { label: 'Ev Tadilatı', href: '/hizmetler/anahtar-teslim/ev-tadilat' },
        { label: 'İç Mimarlık Danışmanlığı', href: '/hizmetler/ic-mimarlik-danismanligi' },
        { label: 'Levent İç Mimarlık Ofisleri', href: '/blog/levent-ic-mimarlik-ofisleri' },
        { label: 'Beşiktaş İç Mimarlık', href: '/istanbul/besiktas-ic-mimarlik' },
      ].map(l => (
        <a href={l.href} class="px-4 py-2 border border-border text-sm text-charcoal hover:border-gold hover:text-gold transition-colors">{l.label}</a>
      ))}
    </div>
  </div>

  <DistrictBlogLinks districtSlug="levent-ic-mimarlik" />

  <RelatedDistricts currentSlug="levent-ic-mimarlik" />

</ServiceLayout>
