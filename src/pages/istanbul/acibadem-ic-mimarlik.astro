---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import RelatedDistricts from '../../components/RelatedDistricts.astro';
import DistrictBlogLinks from '../../components/DistrictBlogLinks.astro';
import DistrictFAQ from '../../components/DistrictFAQ.astro';
import ProcessStrip from '../../components/ProcessStrip.astro';
import DistrictProjects from '../../components/DistrictProjects.astro';
import { CANONICAL_BASE } from '../../config';
import { optimizedImageW, ogImageUrl } from '../../lib/images';
import { getDistrict } from '../../data/districts';

// İlçe adı ve bulunma hali eki tek kaynaktan: src/data/districts.ts.
// Elle yazılan ek Türkçe'de sessizce yanlış olabiliyor (Bağcılar'de → Bağcılar'da).
const district = getDistrict('acibadem-ic-mimarlik')!;
const heroPath = '/images/salon3.jpeg';
const heroAbs = ogImageUrl(heroPath);

const localSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "İç mimarlık, tadilat ve ev yenileme",
  "provider": { "@id": `${CANONICAL_BASE}/#business` },
  "areaServed": { "@type": "Place", "name": "Acıbadem, İstanbul" },
  "url": `${CANONICAL_BASE}/istanbul/acibadem-ic-mimarlik`,
  "description": "Acıbadem ve çevresinde villa yenileme, anahtar teslim daire iç mimarlığı ve mutfak-banyo tadilatı.",
  "image": heroAbs,
};

const faqItems = [
  {
    q: "Acıbadem'de iç mimarlık ve daire/villa yenileme ne kadar sürer?",
    a: "Acıbadem'deki tipik dairelerde anahtar teslim yenileme 5–8 hafta, villa ve büyük apartman dairelerinde 8–12 hafta sürmektedir. Villa projelerinde dış cephe ve bahçe entegrasyonu süreyi etkileyebilir; ilk keşiften sonra net takvim çıkarıyoruz.",
  },
  {
    q: "Acıbadem'de hangi mahalle ve sitelerde hizmet veriyorsunuz?",
    a: "Acıbadem Merkez, Bağlarbaşı, Üsküdar sınırı, Koşuyolu, Hasanpaşa ve Fikirtepe yönü dahil ilçenin tamamında çalışıyoruz. Acıbadem'deki villa projeleri ve yeşil alana yakın site daireleri için özel uygulama yaklaşımımız bulunuyor.",
  },
  {
    q: "Villa tadilatında iç mekan ile bahçe ve dış cephe birlikte ele alınıyor mu?",
    a: "Evet, kapsam istenirse birlikte planlanabiliyor. Salon ve mutfaktan bahçeye açılan geçişler, teras ve giriş alanı iç mekan kurgusunun parçası olduğu için aynı tasarım dilinde ele almak daha tutarlı sonuç veriyor. Dış cephe ve çatı gibi izne bağlı müdahaleleri ise keşifte ayrıca değerlendiriyoruz.",
  },
  {
    q: "Evde yaşarken villa veya büyük daire tadilatı yapılabilir mi?",
    a: "Kapsama bağlı. Yalnızca mutfak ya da banyo gibi sınırlı yenilemelerde ev kullanımı çoğunlukla sürdürülebiliyor; tesisat, zemin ve elektriği baştan ele alan kapsamlı tadilatlarda ise taşınmak çok daha verimli. Keşifte iki senaryoyu da takvim ve toz-gürültü açısından birlikte değerlendiriyoruz.",
  },
  {
    q: "Acıbadem'de keşif ve uygulama takibi nasıl ilerliyor?",
    a: "Ofisimiz Acıbadem'de olduğu için bölgede aynı gün keşif verebiliyoruz; uygulama sürecinde de şantiye ziyaretleri kolay planlanıyor. Tamamladığımız işleri projeler sayfamızdan görebilir, keşif sırasında yapı tipinize en yakın örnekleri birlikte inceleyebiliriz.",
  },
];
---

<ServiceLayout
  title="Acıbadem İç Mimarlık, Villa Tadilatı ve Dekorasyon"
  description="Acıbadem'de iç mimarlık, villa yenileme ve daire tadilatı. Bağlarbaşı, Koşuyolu ve Acıbadem Merkez'de aktif. Ücretsiz keşif: 0533 039 15 65"
  canonicalUrl={`${CANONICAL_BASE}/istanbul/acibadem-ic-mimarlik`}
  h1="Acıbadem İç Mimarlık, Villa Tadilatı ve Dekorasyon"
  eyebrow="İstanbul · Acıbadem"
  lead="Acıbadem'in sakin ve prestijli yapısına uygun, kaliteli malzeme ve özenli işçilikle yenileme projeleri tamamlıyoruz. Villa ve büyük daire projelerinde tadilat ve dekorasyonu baştan sona yönetiyoruz."
  heroImage={heroPath}
  breadcrumb={[
    { label: "Ana Sayfa", href: `${CANONICAL_BASE}/` },
    { label: "İstanbul", href: `${CANONICAL_BASE}/istanbul` },
    { label: "Acıbadem" }
  ]}
  structuredData={localSchema}
>

  <div class="grid md:grid-cols-2 gap-12 py-12 border-b border-border">
    <div>
      <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Acıbadem'de İç Mimarlık ve Villa Yenileme</h2>
      <p class="text-muted leading-relaxed mb-4">
        Acıbadem; Kadıköy'e komşu, yeşil dokusu ve sakin yaşam alanlarıyla tercih edilen, köklü aileler ve profesyonellerin yoğunlaştığı bir semttir. Bu semtte villa ve büyük daire projeleri ağırlıklı olarak talep görür; tasarım her zaman kaliteli malzeme ve detay odağıyla kurulur.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Villa ve büyük daire projelerinde salon, mutfak, yatak odaları ve giyinme odalarının yanı sıra dış mekan-iç mekan geçişlerini, kütüphane ve ev ofis gibi özel alanları da birlikte ele alıyoruz. Ofisimiz Acıbadem'de olduğu için keşif ve uygulama takibini aynı gün içinde yapabiliyoruz.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Acıbadem'de villa ve büyük daire tadilatlarında kararlar tek tek odalardan çok bütünsel bir kurgu üzerinden veriliyor: salon-mutfak akışı, giyinme odası, ev ofis ve bahçe bağlantısı birlikte planlanıyor. Kapsam büyüdükçe 3D görselleştirmeyle uygulama öncesi onay almak karar sürecini kolaylaştırıyor; dekorasyonda malzeme ve aydınlatma seçimleri de bu aşamada netleşiyor.
      </p>
      <p class="text-muted leading-relaxed">
        Acıbadem Merkez, Bağlarbaşı, Koşuyolu, Hasanpaşa ve Üsküdar sınırı başta olmak üzere ilçe genelinde hizmet veriyoruz.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-charcoal mb-4">{district.locative} Sunduğumuz Hizmetler</h3>
      <ul class="space-y-3">
        {[
          'Villa yenileme ve iç mimarlık',
          'Anahtar teslim daire yenileme',
          'Mutfak ve banyo tadilatı',
          'Salon, kütüphane ve ev ofis tasarımı',
          '3D görselleştirme ile tasarım onayı',
          'Lüks malzeme seçimi ve tedarik',
        ].map(item => (
          <li class="flex items-start gap-3 text-sm text-muted">
            <span class="w-4 h-4 mt-0.5 shrink-0 bg-gold/15 rounded-full flex items-center justify-center">
              <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bölge notları -->
  <section class="py-12 border-b border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">{district.locative} Bölge Notlarımız</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Acıbadem Merkez</h3>
        <p class="text-muted text-sm leading-relaxed">
          Villa ve geniş dairelerin yoğunlaştığı, yeşil dokuya yakın çekirdek bölge. Tadilat çoğunlukla çok odalı, bütünsel bir kurgu gerektiriyor; bahçe ve teras bağlantısı tasarıma dahil ediliyor.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Koşuyolu</h3>
        <p class="text-muted text-sm leading-relaxed">
          Sakin, yerleşik bir konut hattı. Apartman ve site dairelerinde mutfak, banyo ve depolamanın güncellenmesi öne çıkıyor; bina yönetimiyle çalışma saati ve moloz çıkışı baştan planlanıyor.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Bağlarbaşı</h3>
        <p class="text-muted text-sm leading-relaxed">
          Karma yapı stoku. Eski apartmanlarda tesisat ve elektrik durumunu keşifte kontrol ediyor, kapsamı sökümden sonra netleştiriyoruz.
        </p>
      </div>
    </div>
  </section>

  <DistrictProjects districtSlug="acibadem-ic-mimarlik" />

  <ProcessStrip districtSlug="acibadem-ic-mimarlik" />

  <DistrictFAQ districtName="Acıbadem" items={faqItems} />

  <div class="py-12 border-t border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Diğer Hizmetlerimiz</h2>
    <div class="flex flex-wrap gap-3">
      {[
        { label: 'Anahtar Teslim Hizmetler', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim` },
        { label: 'Villa Yenileme', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim/villa-yenileme` },
        { label: 'Ofis Yenileme', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim/ofis-yenileme` },
        { label: '3D Tasarım', href: `${CANONICAL_BASE}/hizmetler/3d-tasarim` },
        { label: 'Villa Tadilatı', href: '/hizmetler/anahtar-teslim/villa-tadilat' },
        { label: 'Ev Tadilatı', href: '/hizmetler/anahtar-teslim/ev-tadilat' },
        { label: 'Giyinme Odası Tasarımı', href: '/hizmetler/giyinme-odasi-tasarimi' },
        { label: 'Acıbadem İç Mimarlık Ofisleri', href: '/blog/acibadem-ic-mimarlik-ofisleri' },
        { label: 'Kadıköy İç Mimarlık', href: '/istanbul/kadikoy-ic-mimarlik' },
      ].map(l => (
        <a href={l.href} class="px-4 py-2 border border-border text-sm text-charcoal hover:border-gold hover:text-gold transition-colors">{l.label}</a>
      ))}
    </div>
  </div>

  <DistrictBlogLinks districtSlug="acibadem-ic-mimarlik" />

  <RelatedDistricts currentSlug="acibadem-ic-mimarlik" />

</ServiceLayout>
