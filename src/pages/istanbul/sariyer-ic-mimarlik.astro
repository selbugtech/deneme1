---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import RelatedDistricts from '../../components/RelatedDistricts.astro';
import DistrictBlogLinks from '../../components/DistrictBlogLinks.astro';
import DistrictFAQ from '../../components/DistrictFAQ.astro';
import ProcessStrip from '../../components/ProcessStrip.astro';
import DistrictProjects from '../../components/DistrictProjects.astro';
import { CANONICAL_BASE } from '../../config';
import { optimizedImageW } from '../../lib/cloudinary';
import { getDistrict } from '../../data/districts';
import { getProject } from '../../data/projects';

// İlçe adı ve bulunma hali eki tek kaynaktan: src/data/districts.ts.
// Elle yazılan ek Türkçe'de sessizce yanlış olabiliyor (Bağcılar'de → Bağcılar'da).
const district = getDistrict('sariyer-ic-mimarlik')!;
const heroPath = '/images/salon8.jpeg';
const heroAbs = optimizedImageW(heroPath, 1600);
const refProject = getProject('beykoz-pasabahce');

const localSchema = {
  "@context": "https://schema.org",
  "@type": "InteriorDesigner",
  "name": "Master İç Mimarlık",
  "@id": `${CANONICAL_BASE}/#business`,
  "areaServed": { "@type": "Place", "name": "Sarıyer, İstanbul" },
  "url": `${CANONICAL_BASE}/istanbul/sariyer-ic-mimarlik`,
  "description": "Sarıyer'de villa yenileme, Boğaz hattı daire tadilatı ve iç mimarlık danışmanlığı.",
  "image": heroAbs,
};

const faqItems = [
  {
    q: "Sarıyer'de villa yenileme ne kadar sürer?",
    a: "Sarıyer'de villa projeleri genellikle 10–16 hafta sürüyor. Süreyi belirleyen üç şey var: yapının yaşı ve altyapının yenilenip yenilenmeyeceği, dış cephe ve bahçe düzenlemesinin kapsama dahil olup olmadığı, ve varsa izin süreçleri. Boğaz hattında tamamladığımız 280 m²'lik Beykoz Paşabahçe villası on iki haftada teslim edilmişti; benzer ölçekteki Sarıyer projeleri için de aynı aralığı öngörüyoruz.",
  },
  {
    q: "Sarıyer'de hangi mahallelerde hizmet veriyorsunuz?",
    a: "Tarabya, Yeniköy, İstinye, Emirgan, Baltalimanı, Maslak ve Kilyos hattı başta olmak üzere ilçe genelinde çalışıyoruz. Komşu Zekeriyaköy ve Kemerburgaz bölgesi için ayrı bir sayfamız bulunuyor; kuzey İstanbul villa hattında iki bölgede de aktifiz.",
  },
  {
    q: "Boğaz hattındaki yapılarda tadilat izni gerekiyor mu?",
    a: "Sarıyer'in sahil şeridi Boğaziçi öngörünüm bölgesi kapsamında ve ilçede çok sayıda tescilli yalı ile korunacak yapı bulunuyor. Bu bölgede cephe, çatı, doğrama ve kütleye yönelik müdahaleler özel izne tabidir; iç mekanda taşıyıcı sisteme dokunulmayan yenilemeler ise daha esnek yürür. Keşifte parselin hangi kapsamda olduğunu kontrol ediyor, izin gerekiyorsa süreci baştan anlatıyoruz.",
  },
  {
    q: "Bahçe ve teras düzenlemesi de yapıyor musunuz?",
    a: "Villa projelerinde iç mekan ile dış mekanı birlikte ele alıyoruz. Teras zemin kaplaması, gölgeleme, dış mekan aydınlatması ve iç-dış geçiş detayları tasarımın parçası oluyor. Kapsamlı peyzaj çalışmalarında ise anlaşmalı peyzaj ekibiyle koordineli ilerliyor, şantiye yönetimini yine biz üstleniyoruz.",
  },
  {
    q: "Sarıyer'de kış aylarında şantiye yürütülebilir mi?",
    a: "İç mekan çalışmaları yıl boyu sürdürülebilir. Ancak dış cephe, teras ve bahçe kalemleri sıcaklık ve yağışa duyarlı; boya, derz ve yalıtım uygulamaları için uygun hava koşulu gerekir. Sarıyer'in kuzey hattında kış koşulları daha sert seyrettiği için dış mekan kalemlerini takvimin uygun mevsimine yerleştirip iç mekan işlerini kış aylarına alıyoruz.",
  },
];
---

<ServiceLayout
  title="Sarıyer İç Mimarlık ve Villa Yenileme"
  description="Sarıyer'de villa yenileme, Boğaz hattı daire tadilatı ve iç mimarlık. Tarabya, Yeniköy, İstinye ve Emirgan'da aktif. Ücretsiz keşif: 0533 039 15 65"
  canonicalUrl={`${CANONICAL_BASE}/istanbul/sariyer-ic-mimarlik`}
  h1="Sarıyer İç Mimarlık ve Villa Yenileme"
  eyebrow="İstanbul · Sarıyer"
  lead="Boğaz hattındaki yalı daireleri ve kuzey Sarıyer'in bahçeli villaları. İç mekanı, terası ve bahçe ilişkisini tek proje olarak ele alıyoruz."
  heroImage={heroPath}
  breadcrumb={[
    { label: "Ana Sayfa", href: `${CANONICAL_BASE}/` },
    { label: "İstanbul", href: `${CANONICAL_BASE}/istanbul` },
    { label: "Sarıyer" }
  ]}
  structuredData={localSchema}
>

  <div class="grid md:grid-cols-2 gap-12 py-12 border-b border-border">
    <div>
      <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Sarıyer'de İç Mimarlık Hizmeti</h2>
      <p class="text-muted leading-relaxed mb-4">
        Sarıyer, İstanbul'un en geniş ve en çeşitli ilçelerinden biri. Boğaz kıyısındaki Tarabya, Yeniköy ve
        İstinye hattında tarihi yalılar ve manzaraya yönelen apartman daireleri; iç kesimlerde ve kuzeyde ise
        bahçeli müstakil villalar ve site yapıları bulunuyor. Bu iki grup birbirinden bütünüyle farklı iki
        proje türü demek.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Boğaz hattında tasarımın çıkış noktası neredeyse her zaman manzara oluyor. Pencere hizası, oturma
        grubunun yönü ve aydınlatmanın akşam saatlerinde camda yansıma yaratmayacak biçimde kurgulanması
        belirleyici kararlar. Tescilli yapılarda ve öngörünüm bölgesinde cepheye yönelik müdahaleler izne tabi
        olduğu için kapsamı baştan doğru çizmek kritik.
      </p>
      <p class="text-muted leading-relaxed">
        Villa projelerinde ise iç mekan tek başına ele alınmıyor. Terasın iç mekanla kotu, dış mekan
        aydınlatması, bahçeye açılan doğrama tipi ve yaz-kış kullanım farkı tasarımın parçası. Ayrıca ısıtma,
        yalıtım ve nem yönetimi bu ölçekteki yapılarda dairelere göre çok daha belirleyici oluyor.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-charcoal mb-4">{district.locative} Sunduğumuz Hizmetler</h3>
      <ul class="space-y-3">
        {[
          'Villa yenileme ve kapsamlı tadilat',
          'Boğaz manzaralı dairelerde iç mimari tasarım',
          'Teras ve bahçe entegrasyonu',
          'Elektrik, tesisat ve yalıtım yenilemesi',
          'Özel mobilya tasarımı ve üretimi',
          'İzin ve ruhsat süreçlerinin takibi',
        ].map(item => (
          <li class="flex items-start gap-3 text-sm text-muted">
            <span class="w-4 h-4 mt-0.5 shrink-0 bg-gold/15 rounded-full flex items-center justify-center">
              <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
      {refProject && (
        <a href={`/projeler/${refProject.slug}`} class="group block mt-6 border border-gold/20 bg-gold/5 p-4 hover:border-gold transition-colors">
          <p class="text-[10px] tracking-[0.25em] uppercase text-gold mb-1">Boğaz hattındaki villa projemiz</p>
          <p class="text-sm text-charcoal font-medium group-hover:text-gold transition-colors">{refProject.title}</p>
          <p class="text-muted text-xs mt-1">{refProject.location} · {refProject.area} · {refProject.duration} · {refProject.year}</p>
          <p class="text-xs text-gold mt-2">Proje fotoğraflarını görün →</p>
        </a>
      )}
    </div>
  </div>

  <!-- Bölge notları -->
  <section class="py-12 border-b border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Sarıyer'de Bölge Notlarımız</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Tarabya · Yeniköy · İstinye</h3>
        <p class="text-muted text-sm leading-relaxed">
          Boğaziçi öngörünüm bölgesi. Tescilli yapı yoğunluğu yüksek; cephe ve doğrama müdahaleleri izne tabi.
          Sahil yolundaki trafik nedeniyle sevkiyat saatleri önceden planlanıyor.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Emirgan · Baltalimanı</h3>
        <p class="text-muted text-sm leading-relaxed">
          Manzaraya yönelen apartman daireleri ağırlıkta. Pencere hizası, perde sistemi ve akşam aydınlatmasının
          camda yansıma yaratmaması tasarımın merkezinde duruyor.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Maslak · Kuzey hattı</h3>
        <p class="text-muted text-sm leading-relaxed">
          Ofis ve rezidans yoğunluğu yüksek. Plaza ofislerinde çalışma saatleri ve yük asansörü kullanımı bina
          yönetimince sınırlanıyor; şantiye takvimi buna göre kuruluyor.
        </p>
      </div>
    </div>
  </section>

  <DistrictProjects districtSlug="sariyer-ic-mimarlik" />

  <ProcessStrip districtSlug="sariyer-ic-mimarlik" />

  <DistrictFAQ districtName="Sarıyer" items={faqItems} />

  <div class="py-12 border-t border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Diğer Hizmetlerimiz</h2>
    <div class="flex flex-wrap gap-3">
      {[
        { label: 'Tüm Hizmetler', href: '/hizmetler' },
        { label: 'Villa Yenileme', href: '/hizmetler/anahtar-teslim/villa-yenileme' },
        { label: 'Villa Tadilat', href: '/hizmetler/anahtar-teslim/villa-tadilat' },
        { label: 'Zekeriyaköy İç Mimarlık', href: '/istanbul/zekeriyakoy-ic-mimarlik' },
        { label: 'Sarıyer Ev Tadilatı Rehberi', href: '/blog/sariyer-ev-tadilati' },
        { label: 'Villa Tadilat Rehberi', href: '/blog/villa-tadilati-istanbul' },
      ].map(l => (
        <a href={l.href} class="px-4 py-2 border border-border text-sm text-charcoal hover:border-gold hover:text-gold transition-colors">{l.label}</a>
      ))}
    </div>
  </div>

  <DistrictBlogLinks districtSlug="sariyer-ic-mimarlik" />

  <RelatedDistricts currentSlug="sariyer-ic-mimarlik" />

</ServiceLayout>
