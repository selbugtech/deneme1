---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import RelatedDistricts from '../../components/RelatedDistricts.astro';
import DistrictBlogLinks from '../../components/DistrictBlogLinks.astro';
import DistrictFAQ from '../../components/DistrictFAQ.astro';
import ProcessStrip from '../../components/ProcessStrip.astro';
import DistrictProjects from '../../components/DistrictProjects.astro';
import { CANONICAL_BASE } from '../../config';
import { optimizedImageW, ogImageUrl } from '../../lib/images';
import { getDistrict } from '../../data/districts';

// İlçe adı ve bulunma hali eki tek kaynaktan: src/data/districts.ts.
// Elle yazılan ek Türkçe'de sessizce yanlış olabiliyor (Bağcılar'de → Bağcılar'da).
const district = getDistrict('kadikoy-ic-mimarlik')!;
const heroPath = '/images/salon1.png';
const heroAbs = ogImageUrl(heroPath);

const localSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "İç mimarlık, tadilat ve ev yenileme",
  "provider": { "@id": `${CANONICAL_BASE}/#business` },
  "areaServed": { "@type": "Place", "name": "Kadıköy, İstanbul" },
  "url": `${CANONICAL_BASE}/istanbul/kadikoy-ic-mimarlik`,
  "description": "Kadıköy ve çevresinde anahtar teslim daire yenileme, mutfak-banyo tadilatı ve iç mimarlık danışmanlığı.",
  "image": heroAbs,
};

const faqItems = [
  {
    q: "Kadıköy'de iç mimarlık ve daire yenileme ne kadar sürer?",
    a: "Kadıköy'deki tipik 1+1 ve 2+1 dairelerde anahtar teslim yenileme 4–8 hafta, tam yenileme yapılan 3+1 ve daha büyük dairelerde 6–10 hafta sürmektedir. Eski apartmanlarda tesisat yenilemesi varsa süre üst sınıra yaklaşıyor.",
  },
  {
    q: "Kadıköy'de hangi mahallelerde hizmet veriyorsunuz?",
    a: "Moda, Caddebostan, Fenerbahçe, Göztepe, Suadiye, Bostancı, Kalamış, Erenköy, Sahrayıcedit ve Kadıköy Merkez başta olmak üzere ilçenin tamamında aktif çalışıyoruz. Her mahallenin yapı stoku farklı olduğu için uygulama planını daireye özel kuruyoruz.",
  },
  {
    q: "Moda ve Caddebostan'daki eski apartman dairelerinde tadilata başlamadan önce neye bakıyorsunuz?",
    a: "Önce elektrik panosuna, sıhhi tesisat hatlarına ve ıslak hacim zeminlerine bakıyoruz; eski binalarda bunlar çoğunlukla yenilenmesi gereken kalemler. Bazı yapılar tescilli olabildiği için cephe, pencere ve ortak alanı ilgilendiren müdahalelerde izin gereksinimini keşifte kontrol ediyor, iç mekan tadilatını buna göre kurguluyoruz. Kapsamı sökümden sonra netleştiriyoruz.",
  },
  {
    q: "Kadıköy'de dar sokaklarda malzeme ve moloz taşıma nasıl yönetiliyor?",
    a: "Moda ve Göztepe gibi eski dokulu mahallelerde dar sokak ve sınırlı park alanı, sevkiyat planını belirleyen ana unsur. Dolap ve tezgahları modüler üretip bina yönetimiyle teslimat saati ayarlıyor, moloz tahliyesini de bu saatlere göre planlıyoruz. Asansörsüz binalarda malzeme merdivenden taşındığı için bunu takvime baştan ekliyoruz.",
  },
  {
    q: "Kadıköy'de örnek projeleriniz var mı?",
    a: "Evet. Caddebostan ve Moda'da birer daire ile bir banyo yenileme çalışmamızı proje sayfalarında yayımladık. Keşif sırasında dairenizin tipine ve ölçeğine en yakın örnekleri gösteriyoruz.",
  },
];
---

<ServiceLayout
  title="Kadıköy İç Mimarlık, Ev Tadilatı ve Dekorasyon"
  description="Kadıköy'de iç mimarlık, daire yenileme ve mutfak-banyo tadilatı. Moda, Caddebostan, Fenerbahçe ve Göztepe'de aktif. Ücretsiz keşif: 0533 039 15 65"
  canonicalUrl={`${CANONICAL_BASE}/istanbul/kadikoy-ic-mimarlik`}
  h1="Kadıköy İç Mimarlık, Ev Tadilatı ve Dekorasyon"
  eyebrow="İstanbul · Kadıköy"
  lead="Kadıköy'ün kendine özgü karakterine uygun, modern ve yaşanabilir mekanlar tasarlıyoruz. Anadolu yakasının en dinamik ilçesinde tadilattan dekorasyona işi baştan sona yönetiyoruz."
  heroImage={heroPath}
  breadcrumb={[
    { label: "Ana Sayfa", href: `${CANONICAL_BASE}/` },
    { label: "İstanbul", href: `${CANONICAL_BASE}/istanbul` },
    { label: "Kadıköy" }
  ]}
  structuredData={localSchema}
>

  <div class="grid md:grid-cols-2 gap-12 py-12 border-b border-border">
    <div>
      <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Kadıköy'de İç Mimarlık Hizmeti</h2>
      <p class="text-muted leading-relaxed mb-4">
        Kadıköy; birbirinden farklı mimari dönemlerden kalma binaları, yaratıcı sakinleri ve canlı yaşamıyla İstanbul'un en ilgi çekici ilçelerinden biridir. Buradaki konutlar genellikle büyük balkonlar, yüksek tavanlar ve karakterli detaylar içerir; bu özellikleri korumak çoğu zaman tasarımın çıkış noktası oluyor.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Moda ve Caddebostan'daki klasik apartman dairelerinde özgün dokuyu koruyan restorasyon ağırlıklı uygulamalar yaparken, Bostancı ve Suadiye'deki yeni nesil site dairelerinde planlama ve depolama optimizasyonu öne çıkıyor.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Kadıköy'de tadilat ve dekorasyon kararları çoğu zaman binanın yaşına göre şekilleniyor. Eski apartmanlarda tesisat ve elektrik hattı genellikle keşifte ilk kontrol ettiğimiz kalem oluyor; yeni dönem sitelerde ise öncelik çoğunlukla depolama ve ışık kurgusuna kayıyor. Caddebostan'da <a href="/projeler/caddebostan" class="text-gold hover:underline">daire</a> ve Moda'da <a href="/projeler/kadikoy-moda" class="text-gold hover:underline">daire</a> çalışmalarımızı proje sayfalarında inceleyebilirsiniz.
      </p>
      <p class="text-muted leading-relaxed">
        Moda, Caddebostan, Fenerbahçe, Göztepe, Suadiye, Bostancı, Kalamış, Erenköy ve Sahrayıcedit başta olmak üzere Kadıköy genelinde hizmet veriyoruz.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-charcoal mb-4">{district.locative} Sunduğumuz Hizmetler</h3>
      <ul class="space-y-3">
        {[
          'Anahtar teslim daire yenileme',
          'Mutfak ve banyo yenileme',
          'Salon ve yatak odası tasarımı',
          '3D görselleştirme ile tasarım onayı',
          'Malzeme seçimi ve tedarik',
          'İç mimarlık danışmanlığı',
        ].map(item => (
          <li class="flex items-start gap-3 text-sm text-muted">
            <span class="w-4 h-4 mt-0.5 shrink-0 bg-gold/15 rounded-full flex items-center justify-center">
              <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bölge notları -->
  <section class="py-12 border-b border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">{district.locative} Bölge Notlarımız</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Moda · Fenerbahçe</h3>
        <p class="text-muted text-sm leading-relaxed">
          Köklü apartman dokusunun yoğun olduğu hat. Eski binalarda tesisat ve elektrik genellikle yenileme kapsamına giriyor; dar sokaklar nedeniyle malzeme sevkiyatı ve moloz tahliyesi önceden planlanıyor.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Caddebostan · Göztepe · Erenköy</h3>
        <p class="text-muted text-sm leading-relaxed">
          Geniş balkonlu, yüksek tavanlı klasik daireler çoğunlukta. Özgün detayı korurken mutfak, banyo ve depolamayı güncellemek bu hatta en sık çalıştığımız tadilat ve dekorasyon kurgusu.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Suadiye · Bostancı · Sahrayıcedit</h3>
        <p class="text-muted text-sm leading-relaxed">
          Görece yeni apartman ve site daireleri. Planlama, depolama ve ışık öne çıkıyor; site yönetimiyle çalışma saati ve asansör kullanımı baştan netleştiriliyor.
        </p>
      </div>
    </div>
  </section>

  <DistrictProjects districtSlug="kadikoy-ic-mimarlik" />

  <ProcessStrip districtSlug="kadikoy-ic-mimarlik" />

  <DistrictFAQ districtName="Kadıköy" items={faqItems} />

  <div class="py-12 border-t border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Diğer Hizmetlerimiz</h2>
    <div class="flex flex-wrap gap-3">
      {[
        { label: 'Anahtar Teslim Hizmetler', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim` },
        { label: 'Villa Yenileme', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim/villa-yenileme` },
        { label: 'Ofis Yenileme', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim/ofis-yenileme` },
        { label: '3D Tasarım', href: `${CANONICAL_BASE}/hizmetler/3d-tasarim` },
        { label: 'Ev Tadilatı', href: '/hizmetler/anahtar-teslim/ev-tadilat' },
        { label: 'Mutfak Yenileme', href: '/hizmetler/mutfak-yenileme' },
        { label: 'Banyo Yenileme', href: '/hizmetler/banyo-yenileme' },
        { label: 'Kadıköy Ev Tadilatı Rehberi', href: '/blog/kadikoy-ev-tadilati' },
        { label: 'Üsküdar İç Mimarlık', href: '/istanbul/uskudar-ic-mimarlik' },
      ].map(l => (
        <a href={l.href} class="px-4 py-2 border border-border text-sm text-charcoal hover:border-gold hover:text-gold transition-colors">{l.label}</a>
      ))}
    </div>
  </div>

  <DistrictBlogLinks districtSlug="kadikoy-ic-mimarlik" />

  <RelatedDistricts currentSlug="kadikoy-ic-mimarlik" />

</ServiceLayout>
