---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import RelatedDistricts from '../../components/RelatedDistricts.astro';
import DistrictBlogLinks from '../../components/DistrictBlogLinks.astro';
import DistrictFAQ from '../../components/DistrictFAQ.astro';
import ProcessStrip from '../../components/ProcessStrip.astro';
import DistrictProjects from '../../components/DistrictProjects.astro';
import { CANONICAL_BASE } from '../../config';
import { optimizedImageW } from '../../lib/cloudinary';
import { getDistrict } from '../../data/districts';

// İlçe adı ve bulunma hali eki tek kaynaktan: src/data/districts.ts.
// Elle yazılan ek Türkçe'de sessizce yanlış olabiliyor (Bağcılar'de → Bağcılar'da).
const district = getDistrict('sisli-ic-mimarlik')!;
const heroPath = '/images/salon5.jpeg';
const heroAbs = optimizedImageW(heroPath, 1600);

const localSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "İç mimarlık, tadilat ve ev yenileme",
  "provider": { "@id": `${CANONICAL_BASE}/#business` },
  "areaServed": { "@type": "Place", "name": "Şişli, İstanbul" },
  "url": `${CANONICAL_BASE}/istanbul/sisli-ic-mimarlik`,
  "description": "Şişli ve çevresinde anahtar teslim daire yenileme, rezidans iç mimarlığı ve ticari mekan tasarımı.",
  "image": heroAbs,
};

const faqItems = [
  {
    q: "Şişli'de iç mimarlık ve daire yenileme ne kadar sürer?",
    a: "Şişli'deki tipik 1+1 ve 2+1 dairelerde anahtar teslim yenileme 4–7 hafta, daha büyük rezidans dairelerinde ve ticari mekan projelerinde 6–10 hafta sürmektedir. Eski Şişli apartmanlarında tesisat-elektrik yenilemesi varsa süre üst sınıra yaklaşıyor.",
  },
  {
    q: "Şişli'de hangi mahalle ve sitelerde hizmet veriyorsunuz?",
    a: "Mecidiyeköy, Fulya, Esentepe, Bomonti, Feriköy, Cumhuriyet, Halaskargazi, Gayrettepe, 19 Mayıs ve Şişli Merkez başta olmak üzere ilçe genelinde aktif çalışıyoruz. Ticari mekanlar için Şişli'nin merkezi konumu nedeniyle ofis ve butik tasarım deneyimimiz özellikle güçlüdür.",
  },
  {
    q: "Şişli'deki rezidans ve plaza yanı binalarda tadilat için hangi kurallar gündeme geliyor?",
    a: "Rezidans yönetimleri genellikle yazılı izin, ekip listesi ve çalışma saati sınırı istiyor; yük asansörü kullanımı da belirli aralıklara bağlanabiliyor. Mecidiyeköy ve Esentepe çevresindeki yoğun trafik nedeniyle sevkiyat ve moloz tahliyesi de bu saatlere göre planlanıyor. Gerekli yönetim yazışmalarını ve komşu bilgilendirmesini şantiye takvimine baştan ekliyoruz.",
  },
  {
    q: "Ofis veya butik gibi ticari bir mekanı iş akışını bozmadan yenilemek mümkün mü?",
    a: "Çoğu zaman evet. Mesai sonrası veya hafta sonu çalışma, bölümlere ayırarak aşamalı ilerleme ve gürültülü işleri önceden bir araya toplama gibi yöntemlerle kesintiyi azaltmaya çalışıyoruz. Ticari mekanlarda bina yönetiminin saat ve yükleme kuralları da takvimi belirliyor; bunu keşifte netleştiriyoruz.",
  },
  {
    q: "Şişli'de örnek projeleriniz var mı?",
    a: "Mecidiyeköy'de tamamladığımız 180 m² dubleks yenilemesi Şişli'deki referansımız: on haftada anahtar teslim edildi, uygulama fotoğrafları proje sayfasında. Keşif sırasında dairenizin plan şemasına en yakın çalışmalarımızı gösteriyoruz.",
  },
];
---

<ServiceLayout
  title="Şişli İç Mimarlık, Ev Tadilatı ve Dekorasyon"
  description="Şişli'de iç mimarlık, daire yenileme ve ticari mekan tadilatı. Mecidiyeköy, Fulya, Bomonti ve Şişli Merkez'de aktif. Ücretsiz keşif: 0533 039 15 65"
  canonicalUrl={`${CANONICAL_BASE}/istanbul/sisli-ic-mimarlik`}
  h1="Şişli İç Mimarlık, Ev Tadilatı ve Dekorasyon"
  eyebrow="İstanbul · Şişli"
  lead="Şişli'nin merkezi konumundaki daire, rezidans ve ticari mekanlara modern ve işlevsel iç mekan çözümleri sunuyoruz. Hem konut hem ticari proje deneyimimizle her ihtiyaca cevap veriyoruz."
  heroImage={heroPath}
  breadcrumb={[
    { label: "Ana Sayfa", href: `${CANONICAL_BASE}/` },
    { label: "İstanbul", href: `${CANONICAL_BASE}/istanbul` },
    { label: "Şişli" }
  ]}
  structuredData={localSchema}
>

  <div class="grid md:grid-cols-2 gap-12 py-12 border-b border-border">
    <div>
      <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Şişli'de İç Mimarlık</h2>
      <p class="text-muted leading-relaxed mb-4">
        Şişli; Nişantaşı, Fulya, Bomonti ve Mecidiyeköy gibi farklı karakterlere sahip mahallelerden oluşan heterojen bir ilçedir. Ticari hayatın yoğun olduğu merkezi konumu ve konut çeşitliliğiyle birbirinden çok farklı proje taleplerine ev sahipliği yapar.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Mecidiyeköy ve Fulya'daki yeni rezidans dairelerinde planlama ve depolama optimizasyonu, Bomonti ve Feriköy'deki tarihi apartman dairelerinde ise restorasyon odaklı yenilemeler ön plana çıkıyor. Şişli Merkez ve Cumhuriyet civarında ofis-butik tasarımları için marka kimliği odaklı çalışıyoruz.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Şişli'de konut ve ticari kullanım çoğu zaman aynı sokakta, hatta aynı binada iç içe. Bu yüzden tadilat planında yalnızca daireyi değil, binanın kullanım biçimini de hesaba katıyoruz: iş günlerinde ofis katlarının yoğunluğu, rezidanslarda ise komşu bildirimi ve yönetim kuralları çalışma saatlerini şekillendiriyor. Mecidiyeköy'de tamamladığımız <a href="/projeler/mecidiyekoy-dublex" class="text-gold hover:underline">dubleks yenilemesini</a> proje sayfasında inceleyebilirsiniz.
      </p>
      <p class="text-muted leading-relaxed">
        Şişli Merkez, Mecidiyeköy, Fulya, Esentepe, Bomonti, Feriköy, Cumhuriyet, Halaskargazi, Gayrettepe ve 19 Mayıs başta olmak üzere ilçe genelinde hizmet veriyoruz.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-charcoal mb-4">{district.locative} Sunduğumuz Hizmetler</h3>
      <ul class="space-y-3">
        {[
          'Anahtar teslim daire yenileme',
          'Rezidans iç mimarlığı',
          'Mutfak ve banyo tadilatı',
          'Ofis ve ticari mekan tasarımı',
          '3D görselleştirme ile tasarım onayı',
          'Malzeme seçimi ve tedarik',
        ].map(item => (
          <li class="flex items-start gap-3 text-sm text-muted">
            <span class="w-4 h-4 mt-0.5 shrink-0 bg-gold/15 rounded-full flex items-center justify-center">
              <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bölge notları -->
  <section class="py-12 border-b border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">{district.locative} Bölge Notlarımız</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Mecidiyeköy · Esentepe</h3>
        <p class="text-muted text-sm leading-relaxed">
          İş hayatının yoğun olduğu, rezidans ve ofis katlarının yan yana durduğu hat. Yük asansörü ve çalışma saati kuralları takvimi belirliyor; sevkiyat trafik yoğunluğuna göre planlanıyor.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Fulya · Bomonti</h3>
        <p class="text-muted text-sm leading-relaxed">
          Yeni rezidanslarla eski apartmanların bir arada bulunduğu karma bölge. Yeni dairelerde depolama ve plan, eski binalarda ise tesisat ve elektrik kontrolü ön planda.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Şişli Merkez</h3>
        <p class="text-muted text-sm leading-relaxed">
          Ofis, butik ve konutun iç içe geçtiği merkez. Ticari mekanlarda mesai sonrası çalışma planı, dairelerde ise komşu bildirimi ve yönetim yazışması süreci kolaylaştırıyor.
        </p>
      </div>
    </div>
  </section>

  <DistrictProjects districtSlug="sisli-ic-mimarlik" />

  <ProcessStrip districtSlug="sisli-ic-mimarlik" />

  <DistrictFAQ districtName="Şişli" items={faqItems} />

  <div class="py-12 border-t border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Diğer Hizmetlerimiz</h2>
    <div class="flex flex-wrap gap-3">
      {[
        { label: 'Anahtar Teslim Hizmetler', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim` },
        { label: 'Villa Yenileme', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim/villa-yenileme` },
        { label: 'Ofis Yenileme', href: `${CANONICAL_BASE}/hizmetler/anahtar-teslim/ofis-yenileme` },
        { label: '3D Tasarım', href: `${CANONICAL_BASE}/hizmetler/3d-tasarim` },
        { label: 'Ev Tadilatı', href: '/hizmetler/anahtar-teslim/ev-tadilat' },
        { label: 'Ofis Tadilatı', href: '/hizmetler/anahtar-teslim/ofis-tadilat' },
        { label: 'Mutfak Yenileme', href: '/hizmetler/mutfak-yenileme' },
        { label: 'Şişli Ev Tadilatı Rehberi', href: '/blog/sisli-ev-tadilati' },
        { label: 'Nişantaşı İç Mimarlık', href: '/istanbul/nisantasi-ic-mimarlik' },
      ].map(l => (
        <a href={l.href} class="px-4 py-2 border border-border text-sm text-charcoal hover:border-gold hover:text-gold transition-colors">{l.label}</a>
      ))}
    </div>
  </div>

  <DistrictBlogLinks districtSlug="sisli-ic-mimarlik" />

  <RelatedDistricts currentSlug="sisli-ic-mimarlik" />

</ServiceLayout>
