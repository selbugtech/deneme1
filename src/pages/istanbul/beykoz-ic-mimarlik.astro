---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import RelatedDistricts from '../../components/RelatedDistricts.astro';
import DistrictBlogLinks from '../../components/DistrictBlogLinks.astro';
import DistrictFAQ from '../../components/DistrictFAQ.astro';
import ProcessStrip from '../../components/ProcessStrip.astro';
import DistrictProjects from '../../components/DistrictProjects.astro';
import { CANONICAL_BASE } from '../../config';
import { optimizedImageW } from '../../lib/cloudinary';
import { getDistrict } from '../../data/districts';
import { getProject } from '../../data/projects';

// İlçe adı ve bulunma hali eki tek kaynaktan: src/data/districts.ts.
// Elle yazılan ek Türkçe'de sessizce yanlış olabiliyor (Bağcılar'de → Bağcılar'da).
const district = getDistrict('beykoz-ic-mimarlik')!;
const heroPath = '/images/salon7.jpeg';
const heroAbs = optimizedImageW(heroPath, 1600);
const refProject = getProject('beykoz-pasabahce');

const localSchema = {
  "@context": "https://schema.org",
  "@type": "InteriorDesigner",
  "name": "Master İç Mimarlık",
  "@id": `${CANONICAL_BASE}/#business`,
  "areaServed": { "@type": "Place", "name": "Beykoz, İstanbul" },
  "url": `${CANONICAL_BASE}/istanbul/beykoz-ic-mimarlik`,
  "description": "Beykoz'da villa yenileme, Boğaz hattı konut tadilatı ve anahtar teslim iç mimarlık hizmeti.",
  "image": heroAbs,
};

const faqItems = [
  {
    q: "Beykoz'da villa yenileme ne kadar sürer?",
    a: "Beykoz'da villa projeleri genellikle 10–16 hafta sürüyor. Paşabahçe'de tamamladığımız 280 m² villa 12 haftada, Beykoz merkezdeki 240 m² villa ise 11 haftada teslim edildi. Süreyi belirleyen başlıca üç şey var: altyapının yenilenip yenilenmeyeceği, dış cephe ve bahçe düzenlemesinin kapsama dahil olup olmadığı ve varsa izin süreçleri.",
  },
  {
    q: "Beykoz'da hangi bölgelerde hizmet veriyorsunuz?",
    a: "Paşabahçe, Kanlıca, Anadoluhisarı, Çubuklu, Kavacık, Acarkent ve Beykoz Konakları başta olmak üzere ilçe genelinde çalışıyoruz. Beykoz'da tamamlanmış iki villa projemiz bulunuyor; bölgenin yapı stokunu ve site yönetimi süreçlerini yakından biliyoruz.",
  },
  {
    q: "Boğaz kıyısındaki yapılarda tadilat izni gerekiyor mu?",
    a: "Beykoz'un sahil şeridi Boğaziçi öngörünüm bölgesi kapsamında ve ilçede çok sayıda tescilli yapı bulunuyor. Bu parsellerde cephe, çatı, doğrama ve kütleye yönelik müdahaleler özel izne tabidir. İç mekanda taşıyıcı sisteme dokunulmayan yenilemeler ise daha esnek yürür. Keşifte parselin statüsünü kontrol edip izin gerekiyorsa süreci baştan anlatıyoruz.",
  },
  {
    q: "Villa sitesinde tadilat için site yönetiminden izin gerekir mi?",
    a: "Acarkent ve Beykoz Konakları gibi kapalı sitelerde gerekiyor. Yönetimler genellikle yazılı izin, ekip listesi ve depozito istiyor; ayrıca gürültülü çalışma saatleri ve araç giriş-çıkışı kurala bağlanmış oluyor. Keşif sırasında yönetim planındaki kısıtları birlikte gözden geçirip gerekli başvuruları sizin adınıza yapıyoruz.",
  },
  {
    q: "Kış aylarında Beykoz’da şantiye yürütülebilir mi?",
    a: "İç mekan çalışmaları yıl boyu sürdürülebilir. Ancak dış cephe, teras ve bahçe kalemleri sıcaklık ve yağışa duyarlı; boya, derz ve dış yalıtım uygulamaları uygun hava koşulu istiyor. Beykoz’un koru içi ve kuzey hattında kış koşulları daha sert seyrettiği için dış mekan kalemlerini takvimin uygun mevsimine yerleştirip iç mekan işlerini kış aylarına alıyoruz.",
  },
];
---

<ServiceLayout
  title="Beykoz İç Mimarlık ve Villa Yenileme"
  description="Beykoz'da villa yenileme, Boğaz hattı daire tadilatı ve iç mimarlık. Paşabahçe, Kanlıca ve Acarkent'te tamamlanmış projeler. Ücretsiz keşif: 0533 039 15 65"
  canonicalUrl={`${CANONICAL_BASE}/istanbul/beykoz-ic-mimarlik`}
  h1="Beykoz İç Mimarlık ve Villa Yenileme"
  eyebrow="İstanbul · Beykoz"
  lead="Beykoz'da tamamladığımız iki villa projesi var: Paşabahçe'de 280 m² ve Beykoz merkezde 240 m². Bölgenin bahçeli yapı stokunu ve koruma kısıtlarını yakından biliyoruz."
  heroImage={heroPath}
  breadcrumb={[
    { label: "Ana Sayfa", href: `${CANONICAL_BASE}/` },
    { label: "İstanbul", href: `${CANONICAL_BASE}/istanbul` },
    { label: "Beykoz" }
  ]}
  structuredData={localSchema}
>

  <div class="grid md:grid-cols-2 gap-12 py-12 border-b border-border">
    <div>
      <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Beykoz'da İç Mimarlık Hizmeti</h2>
      <p class="text-muted leading-relaxed mb-4">
        Beykoz, İstanbul'un en düşük yapı yoğunluğuna sahip ilçelerinden biri ve bu, projelerin karakterini doğrudan belirliyor. Burada iş çoğunlukla daire değil, bahçeli müstakil yapı: Paşabahçe ve Kanlıca hattındaki tarihi yalı ve köşkler, Acarkent ve Beykoz Konakları gibi villa siteleri, Çubuklu ve Kavacık çevresindeki müstakil evler.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Villa ölçeğinde çalışmak, dairede karşılaşmadığınız başlıkları gündeme getiriyor. İç mekanla terasın kot ilişkisi, bahçeye açılan doğrama tipi, dış cephe yalıtımı ve nem yönetimi, ısıtma sisteminin büyük hacimde nasıl davrandığı — bunların hepsi projenin parçası. Ayrıca ekip koordinasyonu değişiyor: bir dairede üç ekip sırayla çalışırken, villada altı yedi ekip aynı anda farklı katlarda ilerliyor.
      </p>
      <p class="text-muted leading-relaxed">
        Bölgenin ikinci belirleyici özelliği koruma statüsü. Boğaz kıyı şeridi öngörünüm bölgesi kapsamında ve ilçede tescilli yapı sayısı yüksek. Bu parsellerde cephe, çatı ve kütleye yönelik müdahaleler izne tabi; iç mekanda ise taşıyıcıya dokunulmadığı sürece süreç daha esnek işliyor. Keşifte önce parselin hangi kapsamda olduğunu kontrol ediyoruz.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-charcoal mb-4">{district.locative} Sunduğumuz Hizmetler</h3>
      <ul class="space-y-3">
        {[
          'Villa yenileme ve kapsamlı tadilat',
          'Teras, bahçe ve dış mekan entegrasyonu',
          'Elektrik, tesisat ve yalıtım yenilemesi',
          'Özel mobilya tasarımı ve üretimi',
          'Boğaz manzaralı mekanlarda iç mimari tasarım',
          'İzin ve ruhsat süreçlerinin takibi',
        ].map(item => (
          <li class="flex items-start gap-3 text-sm text-muted">
            <span class="w-4 h-4 mt-0.5 shrink-0 bg-gold/15 rounded-full flex items-center justify-center">
              <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
      {refProject && (
        <a href={`/projeler/${refProject.slug}`} class="group block mt-6 border border-gold/20 bg-gold/5 p-4 hover:border-gold transition-colors">
          <p class="text-[10px] tracking-[0.25em] uppercase text-gold mb-1">Beykoz'daki projemiz</p>
          <p class="text-sm text-charcoal font-medium group-hover:text-gold transition-colors">{refProject.title}</p>
          <p class="text-muted text-xs mt-1">{refProject.location} · {refProject.area} · {refProject.duration} · {refProject.year}</p>
          <p class="text-xs text-gold mt-2">Proje fotoğraflarını görün →</p>
        </a>
      )}
    </div>
  </div>

  <!-- Bölge notları -->
  <section class="py-12 border-b border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Beykoz'da Bölge Notlarımız</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Paşabahçe · Kanlıca · Anadoluhisarı</h3>
        <p class="text-muted text-sm leading-relaxed">
          Boğaz kıyı şeridi; tescilli yapı yoğunluğu yüksek ve öngörünüm bölgesi kısıtları geçerli. Sahil yolundaki trafik nedeniyle malzeme sevkiyatı erken saatlere alınıyor. Paşabahçe’de 280 m² villa projemizi 12 haftada teslim ettik.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Acarkent · Beykoz Konakları</h3>
        <p class="text-muted text-sm leading-relaxed">
          Kapalı villa siteleri. Site yönetimleri tadilat için yazılı izin, çalışma saati kısıtı ve çoğu zaman depozito istiyor; giriş-çıkış kayıtları nedeniyle ekip listesi önceden bildiriliyor. Bu süreçleri sizin adınıza yürütüyoruz.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Çubuklu · Kavacık</h3>
        <p class="text-muted text-sm leading-relaxed">
          Müstakil evler ve ofis yapılarının karışık olduğu bölge. Merkeze görece yakın olması şantiye lojistiğini kolaylaştırıyor; Kavacık hattında ofis ve ticari mekan projeleri de yürütüyoruz.
        </p>
      </div>
    </div>
  </section>

  <DistrictProjects districtSlug="beykoz-ic-mimarlik" />

  <ProcessStrip districtSlug="beykoz-ic-mimarlik" />

  <DistrictFAQ districtName="Beykoz" items={faqItems} />

  <div class="py-12 border-t border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Diğer Hizmetlerimiz</h2>
    <div class="flex flex-wrap gap-3">
      {[
        { label: 'Tüm Hizmetler', href: '/hizmetler' },
        { label: 'Villa Yenileme', href: '/hizmetler/anahtar-teslim/villa-yenileme' },
        { label: 'Villa Tadilat', href: '/hizmetler/anahtar-teslim/villa-tadilat' },
        { label: 'Beykoz Paşabahçe Villa Projesi', href: '/projeler/beykoz-pasabahce' },
        { label: 'Beykoz Villa Projesi', href: '/projeler/beykoz-villa' },
        { label: 'Villa Tadilat Rehberi', href: '/blog/villa-tadilati-istanbul' },
      ].map(l => (
        <a href={l.href} class="px-4 py-2 border border-border text-sm text-charcoal hover:border-gold hover:text-gold transition-colors">{l.label}</a>
      ))}
    </div>
  </div>

  <DistrictBlogLinks districtSlug="beykoz-ic-mimarlik" />

  <RelatedDistricts currentSlug="beykoz-ic-mimarlik" />

</ServiceLayout>
