---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import RelatedDistricts from '../../components/RelatedDistricts.astro';
import DistrictFAQ from '../../components/DistrictFAQ.astro';
import ProcessStrip from '../../components/ProcessStrip.astro';
import { CANONICAL_BASE } from '../../config';
import { optimizedImageW } from '../../lib/cloudinary';

const heroPath = '/images/salon8.jpeg';
const heroAbs = optimizedImageW(heroPath, 1600);

const localSchema = {
  "@context": "https://schema.org",
  "@type": "InteriorDesigner",
  "name": "Master İç Mimarlık",
  "@id": `${CANONICAL_BASE}/#business`,
  "areaServed": { "@type": "Place", "name": "Çekmeköy, İstanbul" },
  "url": `${CANONICAL_BASE}/istanbul/cekmekoy-ic-mimarlik`,
  "description": "Çekmeköy'de villa yenileme, müstakil konut tadilatı ve anahtar teslim iç mimarlık hizmeti.",
  "image": heroAbs,
};

const faqItems = [
  {
    q: "Çekmeköy'de villa yenileme ne kadar sürer?",
    a: "Villa ve müstakil konut projeleri genellikle 10–16 hafta sürüyor. Kapsam iç mekanla sınırlıysa süre alt banda yaklaşıyor; dış cephe, teras ve bahçe düzenlemesi de dahilse üst banda çıkıyor. Site dairelerinde ise anahtar teslim yenileme çoğunlukla 4–8 haftada tamamlanıyor.",
  },
  {
    q: "Çekmeköy'de hangi mahallelerde hizmet veriyorsunuz?",
    a: "Taşdelen, Alemdağ, Ömerli, Merkez, Mimar Sinan ve Ekşioğlu başta olmak üzere ilçe genelinde çalışıyoruz. Bahçeli müstakil konutlarda ve villa sitelerinde yoğunlaşıyoruz.",
  },
  {
    q: "Bahçe ve teras düzenlemesi de yapıyor musunuz?",
    a: "Villa projelerinde iç mekan ile dış mekanı birlikte ele alıyoruz. Teras zemin kaplaması, gölgeleme, dış mekan aydınlatması ve iç-dış geçiş detayları tasarımın parçası oluyor. Kapsamlı peyzaj çalışmalarında anlaşmalı peyzaj ekibiyle koordineli ilerliyor, şantiye yönetimini yine biz üstleniyoruz.",
  },
  {
    q: "Müstakil evde nem ve yalıtım sorunları çıkıyor mu?",
    a: "Sıklıkla. Bodrum ve zemin kat, müstakil yapılarda en çok sorun çıkan bölümler; toprakla temas eden duvarlarda yalıtım eksikse rutubet kaçınılmaz oluyor. Nem kaynağı çözülmeden yapılan yüzeysel bir yenileme birkaç ay içinde geri döndüğü için, bu yapılarda yalıtımı kapsamın ayrılmaz parçası olarak ele alıyoruz.",
  },
  {
    q: "Çekmeköy merkeze uzak, keşfe geliyor musunuz?",
    a: "Evet, ilçe genelinde ücretsiz keşif yapıyoruz. Ofisimiz Acıbadem’de; Çekmeköy’e keşif randevularını genellikle birkaç gün içinde veriyoruz. Uzaklık şantiye takviminde yalnızca sevkiyat planlamasını etkiliyor, bunu da baştan programlıyoruz.",
  },
];
---

<ServiceLayout
  title="Çekmeköy İç Mimarlık ve Villa Yenileme"
  description="Çekmeköy'de villa yenileme, müstakil konut tadilatı ve iç mimarlık. Taşdelen, Alemdağ ve Ömerli'de aktif. Ücretsiz keşif: 0533 039 15 65"
  canonicalUrl={`${CANONICAL_BASE}/istanbul/cekmekoy-ic-mimarlik`}
  h1="Çekmeköy İç Mimarlık ve Villa Yenileme"
  eyebrow="İstanbul · Çekmeköy"
  lead="Bahçeli müstakil konutların ve villa sitelerinin yoğun olduğu bir ilçe. Burada proje iç mekanla bitmiyor; bahçe, teras ve dış cephe de kapsama giriyor."
  heroImage={heroPath}
  breadcrumb={[
    { label: "Ana Sayfa", href: `${CANONICAL_BASE}/` },
    { label: "İstanbul", href: `${CANONICAL_BASE}/istanbul` },
    { label: "Çekmeköy" }
  ]}
  structuredData={localSchema}
>

  <div class="grid md:grid-cols-2 gap-12 py-12 border-b border-border">
    <div>
      <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Çekmeköy'de İç Mimarlık Hizmeti</h2>
      <p class="text-muted leading-relaxed mb-4">
        Çekmeköy, Anadolu yakasının kuzeyinde, Ömerli havzasına komşu ve İstanbul ortalamasının belirgin şekilde altında bir yapı yoğunluğuna sahip. Bu, ilçedeki işlerin karakterini belirliyor: Taşdelen, Alemdağ ve Ömerli hattında bahçeli müstakil evler ve villa siteleri, merkez ve Mimar Sinan çevresinde ise orta ölçekli site daireleri ağırlıkta.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Villa ve müstakil konut projelerinde kapsam iç mekanla sınırlı kalmıyor. Terasın iç mekanla kot ilişkisi, bahçeye açılan doğrama tipi, dış cephe yalıtımı ve büyük hacimde ısıtma performansı projenin parçası oluyor. Ayrıca bu ölçekte nem yönetimi dairelere göre çok daha belirleyici; bodrum ve zemin kat çözümleri ayrı bir başlık olarak ele alınıyor.
      </p>
      <p class="text-muted leading-relaxed">
        İlçenin ikinci grubu olan site dairelerinde ise iş daha standart ilerliyor: altyapı görece yeni olduğu için yıkım ve tesisat aşaması kısalıyor, mesele plan optimizasyonu ve depolama kapasitesine dönüşüyor. Her iki grupta da şantiye lojistiğini önceden planlıyoruz; ilçenin merkeze uzaklığı sevkiyat takvimini etkileyen bir unsur.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-charcoal mb-4">Çekmeköy'de Sunduğumuz Hizmetler</h3>
      <ul class="space-y-3">
        {[
          'Villa ve müstakil konut yenileme',
          'Teras, bahçe ve dış mekan entegrasyonu',
          'Site dairelerinde anahtar teslim yenileme',
          'Elektrik, tesisat ve yalıtım yenilemesi',
          'Özel mobilya tasarımı ve üretimi',
          'Mutfak ve banyo yenileme',
        ].map(item => (
          <li class="flex items-start gap-3 text-sm text-muted">
            <span class="w-4 h-4 mt-0.5 shrink-0 bg-gold/15 rounded-full flex items-center justify-center">
              <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
      <div class="mt-6 p-4 bg-gold/5 border border-gold/20">
        <p class="text-sm text-charcoal font-medium">Benzer ölçekte projelerimiz</p>
        <p class="text-muted text-sm mt-2">
          Beykoz ve Zekeriyaköy hattındaki villa projelerimiz Çekmeköy’deki yapı tipine yakın örnekler. Uygulama fotoğraflarının tamamını proje sayfalarında yayımladık.
        </p>
        <a href="/projeler" class="text-xs text-gold hover:underline mt-2 inline-block">Villa projelerimiz →</a>
      </div>
    </div>
  </div>

  <!-- Bölge notları -->
  <section class="py-12 border-b border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Çekmeköy'de Bölge Notlarımız</h2>
    <div class="grid md:grid-cols-3 gap-6">
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Taşdelen · Alemdağ</h3>
        <p class="text-muted text-sm leading-relaxed">
          Bahçeli müstakil ev ve villa sitelerinin yoğunlaştığı hat. Kapsam iç mekanla sınırlı kalmıyor; teras, bahçe ilişkisi ve dış cephe kalemleri projeye giriyor. Ekip koordinasyonu buna göre planlanıyor.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Ömerli çevresi</h3>
        <p class="text-muted text-sm leading-relaxed">
          Havza sınırına yakın bölgede yapılaşma kısıtları daha katı. Ruhsat gerektiren müdahalelerde parselin hangi kapsamda olduğunu keşif aşamasında kontrol ediyoruz.
        </p>
      </div>
      <div class="border border-border p-6 bg-[#FAF6F1]">
        <h3 class="font-display text-base font-bold text-charcoal mb-2">Merkez · Mimar Sinan</h3>
        <p class="text-muted text-sm leading-relaxed">
          Orta ölçekli site daireleri ağırlıkta. Altyapı görece yeni olduğu için süreç kısalıyor; iş plan optimizasyonu, depolama ve yüzey kalitesi üzerinden ilerliyor.
        </p>
      </div>
    </div>
  </section>

  <ProcessStrip districtName="Çekmeköy" />

  <DistrictFAQ districtName="Çekmeköy" items={faqItems} />

  <div class="py-12 border-t border-border">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Diğer Hizmetlerimiz</h2>
    <div class="flex flex-wrap gap-3">
      {[
        { label: 'Tüm Hizmetler', href: '/hizmetler' },
        { label: 'Villa Yenileme', href: '/hizmetler/anahtar-teslim/villa-yenileme' },
        { label: 'Villa Tadilat', href: '/hizmetler/anahtar-teslim/villa-tadilat' },
        { label: 'Anahtar Teslim Ev Yenileme', href: '/hizmetler/anahtar-teslim/ev-yenileme' },
        { label: 'Ümraniye İç Mimarlık', href: '/istanbul/umraniye-ic-mimarlik' },
        { label: 'Villa Tadilat Rehberi', href: '/blog/villa-tadilati-istanbul' },
      ].map(l => (
        <a href={l.href} class="px-4 py-2 border border-border text-sm text-charcoal hover:border-gold hover:text-gold transition-colors">{l.label}</a>
      ))}
    </div>
  </div>

  <RelatedDistricts currentSlug="cekmekoy-ic-mimarlik" />

</ServiceLayout>
