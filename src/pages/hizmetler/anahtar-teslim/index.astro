---
import ServiceLayout from '../../../layouts/ServiceLayout.astro';
import { CANONICAL_BASE } from '../../../config';
import { optimizedImage } from '../../../lib/cloudinary';
import { byGroup } from '../../../data/services';
import { districts } from '../../../data/districts';

// Bu sayfa, /hizmetler/anahtar-teslim/ altındaki 18 sayfanın tamamını kapsar.
const yenileme = byGroup('anahtar-teslim');
const tadilat = byGroup('tadilat');
const mekan = byGroup('mekan');
const tumu = [...yenileme, ...tadilat, ...mekan];

const bloklar = [
  {
    eyebrow: 'Yenileme',
    title: 'Altyapıya Dokunmadan Yenileme',
    intro: 'Elektrik ve tesisat sağlamsa mekanı yeniden kurmak için yıkıma gerek yok. Zemin, kaplama, dolap, tezgah ve aydınlatma güncellemeleriyle mekan kısa sürede başka bir karaktere kavuşuyor.',
    items: yenileme,
  },
  {
    eyebrow: 'Tadilat',
    title: 'Teknik ve Yapısal Müdahale',
    intro: 'Eski tesisat, sızdıran su hattı ya da kullanışsız plan şeması varsa yüzeysel bir güncelleme sorunu çözmüyor. Bu kapsamda altyapı baştan kuruluyor, gerektiğinde duvarlar kaldırılıyor.',
    items: tadilat,
  },
  {
    eyebrow: 'Özel Mekan Tipleri',
    title: 'Mevzuat ve Teknik Gereklilik Odaklı',
    intro: 'Bazı mekanlarda tasarımdan önce ruhsat şartları ve teknik zorunluluklar konuşuluyor: klinikte hijyen ve mahal ölçüleri, kreşte güvenlik, spor salonunda titreşim yalıtımı, eczanede raf verimi.',
    items: mekan,
  },
];

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Anahtar Teslim Tadilat ve Yenileme",
  "name": "İstanbul Anahtar Teslim Tadilat ve Yenileme Hizmetleri",
  "description": "İstanbul'da mekan tipine göre anahtar teslim yenileme, kapsamlı tadilat ve özel mekan uygulamaları. Tasarım, malzeme tedariki, usta koordinasyonu ve şantiye yönetimi tek çatı altında.",
  "provider": { "@id": `${CANONICAL_BASE}/#business` },
  "areaServed": { "@type": "City", "name": "İstanbul" },
  "url": `${CANONICAL_BASE}/hizmetler/anahtar-teslim`,
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Anahtar Teslim Hizmetler",
  "description": "Mekan tipine göre anahtar teslim yenileme, tadilat ve özel mekan hizmetleri.",
  "itemListElement": tumu.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": s.title,
    "url": `${CANONICAL_BASE}${s.href}`,
  })),
};

const faqItems = [
  {
    q: 'Anahtar teslim yenileme ile tadilat arasındaki fark nedir?',
    a: 'Yenileme; taşıyıcı sisteme, elektrik ve tesisat altyapısına dokunmadan yapılan estetik ve işlevsel güncellemedir — zemin, kaplama, dolap, tezgah ve aydınlatma gibi kalemleri kapsar. Tadilat ise elektrik ve sıhhi tesisat yenilemesi, duvar kaldırma veya ekleme, ıslak hacim yer değişikliği gibi yapısal ve teknik müdahaleleri içerir. Hangisine ihtiyacınız olduğunu keşifte mevcut durumu görerek netleştiriyoruz.',
  },
  {
    q: 'Anahtar teslim yenileme ne kadar sürer?',
    a: 'Ortalama bir mekan (90–150 m²) 6–10 hafta içinde tamamlanıyor. Altyapıya dokunulmayan yenilemelerde süre alt banda yaklaşırken, elektrik ve tesisatın baştan kurulduğu tadilat kapsamında üst banda çıkıyor. Villa ve ticari mekan projeleri 8–16 hafta sürebiliyor. Kesin takvim keşif sonrası netleşir ve sözleşmede yazılı olarak belirlenir.',
  },
  {
    q: 'Hangi mekan türleri için hizmet veriyorsunuz?',
    a: 'Ev ve daire, villa, ofis, mağaza ve dükkan, cafe ve restoran, otel projelerinin hem yenileme hem tadilat kapsamını yürütüyoruz. Bunlara ek olarak klinik ve muayenehane, kuaför ve güzellik salonu, eczane, showroom, spor salonu ile kreş gibi mevzuat ve teknik gereklilik içeren özel mekanlarda da çalışıyoruz.',
  },
  {
    q: 'Sözleşme sonrası ek maliyet çıkar mı?',
    a: 'Hayır. Sözleşmede belirlenen kapsam dışına çıkmıyoruz. Uygulama sırasında beklenmedik bir yapısal sorun ortaya çıkarsa (örneğin gizli su hasarı) sizi derhal bilgilendiriyor, yazılı onayınız olmadan ek iş yapmıyoruz.',
  },
  {
    q: 'Mekan işletmedeyken tadilat yapılabilir mi?',
    a: 'Ticari mekanlarda fazlı uygulama yapıyoruz: alanı bölümlere ayırıp bir bölüm kapalıyken diğerinde hizmet sürüyor. Toz bariyeri ve mesai dışı çalışma bu düzenin standart parçaları. Ancak zemin değişimi ve altyapı yenilemesi gibi kalemlerde kısa süreli tam kapanma hem daha hızlı hem daha ekonomik oluyor; kapalı kalınacak süreyi baştan gün gün paylaşıyoruz.',
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<ServiceLayout
  title="Anahtar Teslim Tadilat ve Yenileme Hizmetleri | İstanbul"
  description="İstanbul'da mekan tipine göre anahtar teslim yenileme, tadilat ve özel mekan uygulamaları. Ev, villa, ofis, mağaza, cafe ve otel. Ücretsiz keşif: 0533 039 15 65"
  canonicalUrl={`${CANONICAL_BASE}/hizmetler/anahtar-teslim`}
  h1="Anahtar Teslim Tadilat ve Yenileme"
  eyebrow="Hizmet Kategorisi"
  expandedByDefault={true}
  lead="Mekan tipine göre 18 hizmet tek sayfada. Yenileme, kapsamlı tadilat ve mevzuat gerektiren özel mekanlar — hepsinde tasarım, malzeme tedariki, usta koordinasyonu ve şantiye yönetimi tek çatı altında."
  breadcrumb={[
    { label: "Ana Sayfa", href: `${CANONICAL_BASE}/` },
    { label: "Hizmetler", href: `${CANONICAL_BASE}/hizmetler` },
    { label: "Anahtar Teslim" }
  ]}
  heroImage="/images/salon2.jpeg"
  ogImage={optimizedImage('/images/salon2.jpeg')}
  structuredData={[serviceSchema, itemListSchema, faqSchema]}
>

  <!-- Üç kategori bloğu: 18 hizmetin tamamı -->
  {bloklar.map(blok => (
    <section class="py-12 border-b border-border">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-px bg-gold"></span>
        <span class="text-xs tracking-[0.3em] uppercase text-gold font-medium">{blok.eyebrow}</span>
      </div>
      <h2 class="font-display text-3xl font-bold text-charcoal mb-4">{blok.title}</h2>
      <p class="text-muted leading-relaxed max-w-3xl mb-8">{blok.intro}</p>
      <div class="grid md:grid-cols-2 gap-6">
        {blok.items.map(s => (
          <a
            href={s.href}
            class="group border border-border p-7 hover:border-gold transition-colors duration-200 flex gap-5 items-start"
          >
            <div class="text-gold shrink-0 mt-1 group-hover:scale-110 transition-transform duration-300" set:html={s.icon} />
            <div>
              <h3 class="font-display text-lg font-bold text-charcoal mb-2 group-hover:text-gold transition-colors">{s.title}</h3>
              <p class="text-muted text-sm leading-relaxed mb-3">{s.desc}</p>
              <span class="text-xs text-gold inline-flex items-center gap-1.5">
                Detaylı Bilgi
                <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}

  <!-- What is it + Scope -->
  <div class="grid md:grid-cols-2 gap-12 py-12 border-b border-border">
    <div>
      <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Anahtar Teslim Çalışmak Ne Demek?</h2>
      <p class="text-muted leading-relaxed mb-4">
        Anahtar teslim; iç mimari tasarım, malzeme tedariki, usta koordinasyonu ve uygulama dahil tüm sürecin tek bir firma tarafından yönetildiği çalışma modelidir.
      </p>
      <p class="text-muted leading-relaxed mb-4">
        Geleneksel modelde müşteri her ustayı ayrı ayrı bulmak, malzeme tedarikini koordine etmek ve ekipler arası sırayı kendisi kurmak zorunda kalır. Anahtar teslimde bu yükün tamamı tek sözleşme altında toplanır; süreç boyunca tek muhatabınız olur.
      </p>
      <p class="text-muted leading-relaxed">
        Kapsamın yenileme mi yoksa tadilat mı olduğuna mekanı görmeden karar vermiyoruz. Ücretsiz keşifte mevcut tesisatın durumu, zemin ve duvar yapısı ile taşıyıcı sistem değerlendirilir; ardından size en uygun kapsamı gerekçesiyle birlikte sunarız.
      </p>
    </div>
    <div>
      <h3 class="font-semibold text-charcoal mb-4 text-xs uppercase tracking-wider">Hizmete Dahil Olanlar</h3>
      <ul class="space-y-3">
        {[
          'İç mimari konsept tasarım',
          'Fotorealistik 3D görselleştirme',
          'Malzeme seçimi ve tedariki',
          'Şantiye yönetimi ve koordinasyon',
          'Elektrik, tesisat, alçıpan uygulamaları',
          'Zemin, duvar ve tavan kaplamaları',
          'Boya ve dekor uygulamaları',
          'Son temizlik ve teslim',
        ].map(item => (
          <li class="flex items-start gap-3 text-sm text-muted">
            <span class="w-4 h-4 mt-0.5 shrink-0 bg-gold/15 rounded-full flex items-center justify-center">
              <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
              </svg>
            </span>
            {item}
          </li>
        ))}
      </ul>
      <div class="mt-6 p-4 bg-gold/5 border border-gold/20">
        <p class="text-sm text-charcoal font-medium">Tek odayla başlamak isterseniz</p>
        <p class="text-muted text-sm mt-2">
          Tüm mekanı yenilemek zorunda değilsiniz.
          <a href="/hizmetler/mutfak-yenileme" class="text-gold hover:underline">Mutfak</a>,
          <a href="/hizmetler/banyo-yenileme" class="text-gold hover:underline">banyo</a> ve diğer
          <a href="/hizmetler" class="text-gold hover:underline">oda bazlı hizmetlerimize</a> göz atabilirsiniz.
        </p>
      </div>
    </div>
  </div>

  <!-- Process -->
  <div class="py-12 border-b border-border">
    <div class="flex items-center gap-3 mb-8">
      <span class="w-8 h-px bg-gold"></span>
      <h2 class="font-display text-2xl font-bold text-charcoal">Anahtar Teslim Sürecimiz</h2>
    </div>
    <div class="grid md:grid-cols-5 gap-6">
      {[
        { step: '01', title: 'Ücretsiz Keşif', desc: 'Projenizi yerinde değerlendirip ilk fikirlerimizi paylaşıyoruz.' },
        { step: '02', title: '3D Tasarım', desc: 'Mekanınızı gerçekçi görsellerle deneyimleyin ve onaylayın.' },
        { step: '03', title: 'Sözleşme', desc: 'Kapsam, takvim ve ödeme planı yazılı olarak netleşir.' },
        { step: '04', title: 'Uygulama', desc: 'Şantiye yönetimi tamamen bizde. Sizi düzenli bilgilendiriyoruz.' },
        { step: '05', title: 'Teslim', desc: 'Temizlenmiş, eksiksiz hazır mekanınızı teslim alırsınız.' },
      ].map(item => (
        <div class="text-center">
          <div class="w-12 h-12 bg-gold/10 rounded-full flex items-center justify-center mx-auto mb-3">
            <span class="text-gold font-display font-bold text-sm">{item.step}</span>
          </div>
          <h3 class="font-semibold text-charcoal text-sm mb-2">{item.title}</h3>
          <p class="text-muted text-xs leading-relaxed">{item.desc}</p>
        </div>
      ))}
    </div>
  </div>

  <!-- Service Areas -->
  <div class="py-12 border-b border-border">
    <div class="flex items-center gap-3 mb-6">
      <span class="w-8 h-px bg-gold"></span>
      <h2 class="font-display text-2xl font-bold text-charcoal">Hizmet Verdiğimiz İlçeler</h2>
    </div>
    <p class="text-muted leading-relaxed max-w-3xl mb-6">
      Her ilçenin yapı stoku farklı olduğu için uygulama planını bulunduğunuz bölgenin koşullarına göre kuruyoruz.
      İlçe sayfalarımızda o bölgeye özgü notlarımızı bulabilirsiniz.
    </p>
    <div class="flex flex-wrap gap-2">
      {districts.map(d => (
        <a href={`/istanbul/${d.slug}`} class="px-3 py-1.5 border border-border text-charcoal text-xs font-medium hover:border-gold hover:text-gold transition-colors">
          {d.name}
        </a>
      ))}
      <a href="/istanbul" class="px-3 py-1.5 border border-gold text-gold text-xs font-medium hover:bg-gold/5 transition-colors">
        Tüm bölgeler →
      </a>
    </div>
  </div>

  <!-- FAQ -->
  <div class="py-12">
    <div class="flex items-center gap-3 mb-6">
      <span class="w-8 h-px bg-gold"></span>
      <h2 class="font-display text-2xl font-bold text-charcoal">Sık Sorulan Sorular</h2>
    </div>
    <div class="divide-y divide-border">
      {faqItems.map((faq, i) => (
        <details class="group py-5" open={i === 0}>
          <summary class="flex items-start justify-between cursor-pointer list-none gap-4">
            <h3 class="font-semibold text-charcoal text-sm md:text-base group-open:text-gold transition-colors">{faq.q}</h3>
            <svg class="shrink-0 w-5 h-5 text-gold mt-0.5 group-open:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </summary>
          <p class="mt-3 text-muted text-sm leading-relaxed pr-8">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>

</ServiceLayout>
