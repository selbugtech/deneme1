---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { CANONICAL_BASE } from '../../config';
import { optimizedImage } from '../../lib/cloudinary';
import { styles } from '../../data/styles';

const heroPath = '/images/salon5.jpeg';
const others = styles.filter(s => s.slug !== 'modern');

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Modern İç Mimarlık — İstanbul Dairelerinde Uygulama Rehberi",
  "description": "Modern iç mimarlığın malzeme paleti, plan yaklaşımı ve İstanbul dairelerinde nasıl uygulandığı.",
  "author": { "@id": `${CANONICAL_BASE}/#organization` },
  "publisher": { "@id": `${CANONICAL_BASE}/#organization` },
  "mainEntityOfPage": `${CANONICAL_BASE}/ic-mimarlik/modern`,
};

const faqItems = [
  {
    q: "Modern ve çağdaş (kontemporer) iç mimarlık aynı şey mi?",
    a: "Hayır, sık karıştırılıyor. Modern, 20. yüzyılın ortasında biçimlenmiş ve kendi içinde tanımlı bir dil: yalın geometri, işlevin biçimi belirlemesi, süslemeden kaçınma. Çağdaş ise güncel olanı ifade ediyor ve içeriği yıldan yıla değişiyor. Modern kurgular bu nedenle daha zamansız kalıyor; çağdaş tercihler ise döneme bağlı olduğu için daha hızlı eskiyor.",
  },
  {
    q: "Modern tasarım soğuk mu görünür?",
    a: "Yanlış uygulandığında evet. Modern dilin soğuk algılanması genellikle tek bir sebepten kaynaklanıyor: mekanda hiç doku olmaması. Sert ve mat yüzeylerin baskın olduğu, tekstilin azaltıldığı bir kurgu kaçınılmaz olarak steril görünüyor. Doğal ahşap, yün ve keten gibi dokulu malzemeleri sınırlı ama bilinçli kullanmak, yalınlıktan ödün vermeden mekanı sıcaklaştırıyor.",
  },
  {
    q: "Küçük dairelerde modern tasarım işe yarar mı?",
    a: "Küçük dairelerde en iyi çalışan yaklaşımlardan biri. Gereksiz elemanın azaltılması, gömme depolamanın öne çıkması ve zemin kaplamasının mekan boyunca kesintisiz sürdürülmesi, dar planlarda gözle görülür bir ferahlık kazandırıyor. Ayrıca yerden yüksek ayaklı mobilya kullanımı, altındaki zemin göründüğü için mekanı görsel olarak genişletiyor.",
  },
  {
    q: "Modern bir salonda hangi renkleri kullanmalıyım?",
    a: "Modern palette baskın renkler nötr kalıyor: kırık beyaz, açık ve orta gri tonları, doğal ahşap. Renk, mekanın tamamına yayılmak yerine sınırlı sayıda noktada — bir koltuk, bir halı, bir sanat eseri — kullanıldığında daha güçlü sonuç veriyor. Odanın aldığı ışık burada belirleyici: kuzey cepheli odalarda nötrleri sıcak tarafta, güney cepheli odalarda ise serin tarafta seçmek dengeyi kuruyor.",
  },
  {
    q: "Eski bir apartman dairesine modern tasarım uygulanabilir mi?",
    a: "Evet ve genellikle çok iyi sonuç veriyor. Eski binaların yüksek tavanı ve geniş pencereleri, modern dilin ihtiyaç duyduğu ferahlığı zaten sağlıyor. Burada karar verilmesi gereken şey özgün detayların ne kadarının korunacağı: kornis, tavan göbeği ve ahşap doğrama gibi öğeleri tamamen kaldırmak yerine sadeleştirerek korumak, mekana modern kurguda bulunması zor bir karakter katıyor.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const ilkeler = [
  { t: 'İşlev biçimi belirler', d: 'Her eleman bir işe yarıyor; dekoratif olsun diye eklenen öğe yok. Bir rafın konumu neyi taşıyacağına, bir bölmenin yeri hangi akışı ayıracağına göre belirleniyor.' },
  { t: 'Yatay hatlar', d: 'Uzun ve kesintisiz yatay çizgiler mekanı genişletiyor. Kulpsuz dolap kapakları, hizalanmış üst kotlar ve mekan boyunca süren zemin bu etkiyi kuran başlıca araçlar.' },
  { t: 'Görsel sadeleştirme', d: 'Depolamanın kapalı olması, kablo ve tesisatın gizlenmesi, yüzey sayısının azaltılması. Modern dilin ferahlığı boş alandan değil, göze çarpan eleman sayısının azlığından geliyor.' },
  { t: 'Sınırlı ama gerçek malzeme', d: 'Az sayıda malzeme, buna karşılık taklit yerine gerçek olanı. Doğal ahşap, gerçek taş ve mat metal; modern paletin taşıyıcı üçlüsü.' },
];

const hatalar = [
  { t: 'Dokuyu tamamen çıkarmak', d: 'Yalınlık adına tüm dokunun kaldırıldığı mekanlar steril görünüyor. Yün halı, keten perde ve dokusu belli bir ahşap, sadelikten ödün vermeden bu sorunu çözüyor.' },
  { t: 'Tek tavan armatürüne bağlı kalmak', d: 'Modern kurgunun temiz tavanı, aydınlatmanın gizlenmesini gerektiriyor. Ancak bu tek bir merkezi armatüre indirgendiğinde mekan akşam saatlerinde düz ve yorucu hale geliyor.' },
  { t: 'Depolamayı sonraya bırakmak', d: 'Kapalı depolama modern dilin ön koşulu. Yeterli hacim baştan planlanmadığında eşyalar açıkta kalıyor ve mekanın tüm sadeliği ilk aydan itibaren bozuluyor.' },
  { t: 'Parlak yüzeyi abartmak', d: 'Yüksek parlaklıktaki panellerde parmak izi ve çizik hemen görünür hale geliyor. Mutfak gibi yoğun kullanılan alanlarda mat ve yarı mat yüzeyler günlük kullanımda çok daha iyi yaşlanıyor.' },
];
---

<ServiceLayout
  title="Modern İç Mimarlık — İstanbul Uygulama Rehberi"
  description="Modern iç mimarlık nedir, malzeme paleti nasıl kurulur ve İstanbul dairelerinde nasıl uygulanır? Sık yapılan hatalar ve çözümleri. 0533 039 15 65"
  canonicalUrl={`${CANONICAL_BASE}/ic-mimarlik/modern`}
  h1="Modern İç Mimarlık"
  eyebrow="Stil Rehberi"
  lead="Yalın geometri, açık plan ve gösterişten kaçınan bir malzeme dili. Türkiye'de en çok talep edilen yaklaşım — ve yanlış uygulandığında en çok soğuk bulunan."
  heroImage={heroPath}
  ogImage={optimizedImage(heroPath)}
  expandedByDefault={true}
  breadcrumb={[
    { label: "Ana Sayfa", href: `${CANONICAL_BASE}/` },
    { label: "İç Mimarlık Stilleri", href: `${CANONICAL_BASE}/ic-mimarlik` },
    { label: "Modern" }
  ]}
  structuredData={[articleSchema, faqSchema]}
>

  <section class="py-12 border-b border-border">
    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Modern Dil Neyi Çıkarır?</h2>
        <p class="text-muted leading-relaxed mb-4">
          Modern iç mimarlığı tanımlayan şey eklediği değil, çıkardığı şeyler. Süsleme, gereksiz profil,
          işlevi olmayan dekoratif eleman ve görsel gürültü kaldırıldığında geriye mekanın kendi oranları,
          ışığı ve malzemesi kalıyor. Bu yaklaşımın en büyük avantajı zamansızlığı: döneme özgü bir tercihe
          yaslanmadığı için on yıl sonra da güncel kalabiliyor.
        </p>
        <p class="text-muted leading-relaxed mb-4">
          Türkiye'de en çok talep edilen dil olması da bundan. Ama aynı zamanda en sık şikâyet edilen dil:
          "soğuk buldum", "otel gibi oldu", "ev sıcaklığı kalmadı". Bu şikâyetlerin neredeyse tamamı tek bir
          uygulama hatasından çıkıyor — yalınlık adına mekandan tüm dokunun çıkarılması.
        </p>
        <p class="text-muted leading-relaxed">
          Modern kurguda doku, sadeliğin karşıtı değil tamamlayıcısıdır. Sınırlı sayıda ama gerçek malzeme
          kullanmak — dokusu belli bir doğal ahşap, yün bir halı, keten bir perde — mekanı yalın tutarken
          yaşanabilir kılıyor. Projelerimizde palette daima en az bir doğal ve dokulu yüzey bulundurmamızın
          sebebi bu.
        </p>
      </div>
      <div>
        <div class="border border-border p-7 bg-[#FAF6F1] mb-6">
          <p class="text-[10px] tracking-[0.25em] uppercase text-gold mb-3">Malzeme ve renk paleti</p>
          <ul class="space-y-2 text-sm text-muted">
            <li>· Kırık beyaz ve açık gri duvar yüzeyleri</li>
            <li>· Orta tonda doğal ahşap (meşe, ceviz)</li>
            <li>· Mat siyah veya füme metal detaylar</li>
            <li>· Büyük format, düşük derzli zemin kaplaması</li>
            <li>· Sınırlı sayıda renk vurgusu</li>
          </ul>
        </div>
        <h3 class="font-semibold text-charcoal mb-4">En iyi çalıştığı mekanlar</h3>
        <ul class="space-y-3">
          {[
            'Açık planlı salon ve salon-mutfak birleşimleri',
            'Küçük ve orta ölçekli daireler',
            'Bol ışık alan güney ve batı cepheli mekanlar',
            'Yeni teslim site daireleri',
            'Ofis ve ticari mekanlar',
          ].map(item => (
            <li class="flex items-start gap-3 text-sm text-muted">
              <span class="w-4 h-4 mt-0.5 shrink-0 bg-gold/15 rounded-full flex items-center justify-center">
                <svg class="w-2.5 h-2.5 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                </svg>
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="py-12 border-b border-border">
    <h2 class="font-display text-3xl font-bold text-charcoal mb-8">Modern Kurgunun Dört İlkesi</h2>
    <div class="grid md:grid-cols-2 gap-6">
      {ilkeler.map((k, i) => (
        <div class="border border-border p-7 bg-[#FAF6F1]">
          <p class="text-[10px] tracking-[0.25em] uppercase text-gold mb-2">0{i + 1}</p>
          <h3 class="font-display text-lg font-bold text-charcoal mb-2">{k.t}</h3>
          <p class="text-muted text-sm leading-relaxed">{k.d}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="py-12 border-b border-border">
    <h2 class="font-display text-3xl font-bold text-charcoal mb-4">Uygulamada En Sık Görülen Dört Hata</h2>
    <div class="space-y-4">
      {hatalar.map((h, i) => (
        <div class="flex gap-5 border border-border p-6 bg-[#FAF6F1]">
          <p class="font-display text-2xl font-bold text-gold/40 shrink-0">0{i + 1}</p>
          <div>
            <h3 class="font-semibold text-charcoal mb-1">{h.t}</h3>
            <p class="text-muted text-sm leading-relaxed">{h.d}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="py-12 border-b border-border">
    <div class="flex items-center gap-3 mb-4">
      <span class="w-8 h-px bg-gold"></span>
      <span class="text-xs tracking-[0.3em] uppercase text-gold font-medium">Sıkça Sorulan Sorular</span>
    </div>
    <h2 class="font-display text-3xl font-bold text-charcoal mb-8">Modern iç mimarlık hakkında</h2>
    <div class="space-y-4">
      {faqItems.map(f => (
        <details class="border border-border bg-[#FAF6F1] p-6 group">
          <summary class="font-semibold text-charcoal cursor-pointer list-none flex items-start justify-between gap-4">
            <span>{f.q}</span>
            <span class="text-gold shrink-0 transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="text-muted text-sm leading-relaxed mt-4">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="py-12">
    <h2 class="font-display text-2xl font-bold text-charcoal mb-6">Diğer Stiller</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      {others.map(s => (
        <a href={`/ic-mimarlik/${s.slug}`} class="group block border border-border p-5 hover:border-gold hover:bg-gold/5 transition-colors">
          <h3 class="font-display text-base font-bold text-charcoal group-hover:text-gold transition-colors mb-1">{s.fullName}</h3>
          <p class="text-muted text-xs">{s.tagline}</p>
        </a>
      ))}
    </div>
    <div class="flex flex-wrap gap-3">
      {[
        { label: 'Salon Tasarımı', href: '/hizmetler/salon-tasarimi' },
        { label: 'Anahtar Teslim Ev Yenileme', href: '/hizmetler/anahtar-teslim/ev-yenileme' },
        { label: '3D Tasarım', href: '/hizmetler/3d-tasarim' },
        { label: 'İç Mimarlık Trendleri', href: '/blog/ic-mimarlik-trendleri-2025' },
      ].map(l => (
        <a href={l.href} class="px-4 py-2 border border-border text-sm text-charcoal hover:border-gold hover:text-gold transition-colors">{l.label}</a>
      ))}
    </div>
  </section>

</ServiceLayout>
