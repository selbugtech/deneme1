---
import { districts, getDistrict } from '../data/districts';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;
const current = getDistrict(currentSlug);

// Eskiden `districts.filter(...).slice(0, 4)` idi: her ilçe sayfası AYNI ilk dört
// ilçeyi gösteriyordu (Kadıköy, Üsküdar, Acıbadem, Ataşehir). Sonuç olarak 23 ilçe
// sayfası kardeşlerinden neredeyse hiç link almıyor, link değeri ilk dördünde
// havuzlanıyordu.
//
// Şimdi: aynı yakadan 6 + karşı yakadan 2. Kullanıcıya coğrafi olarak anlamlı,
// Google'a da 27 sayfaya dağılmış bir link grafiği veriyor.
const pool = districts.filter((d) => d.slug !== currentSlug);
const sameSide = pool.filter((d) => d.side === current?.side);
const otherSide = pool.filter((d) => d.side !== current?.side);

// Deterministik döndürme — her sayfa farklı bir set gösteriyor ama çıktı build'ler
// arasında sabit kalıyor. BlogPost.astro'daki ilgili-yazı mantığıyla aynı desen.
const seed = Math.max(districts.findIndex((d) => d.slug === currentSlug), 0);
const rotate = <T,>(a: T[]): T[] => (a.length ? [...a.slice(seed % a.length), ...a.slice(0, seed % a.length)] : a);

const others = [...rotate(sameSide).slice(0, 6), ...rotate(otherSide).slice(0, 2)];
---

<section class="py-12 border-t border-border">
  <div class="flex items-center gap-3 mb-6">
    <span class="w-8 h-px bg-gold"></span>
    <span class="text-xs tracking-[0.3em] uppercase text-gold font-medium">Diğer Bölgeler</span>
  </div>
  <h2 class="font-display text-2xl md:text-3xl font-bold text-charcoal mb-6">Hizmet verdiğimiz diğer ilçeler</h2>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
    {others.map(d => (
      <a
        href={`/istanbul/${d.slug}`}
        class="block px-4 py-3 border border-border hover:border-gold hover:bg-gold/5 transition-colors text-charcoal text-sm tracking-wide"
      >
        <span class="block font-medium">{d.name}</span>
        <span class="block text-xs text-muted mt-0.5">{d.focus}</span>
      </a>
    ))}
  </div>
  <a href="/istanbul" class="inline-block mt-6 text-sm text-gold hover:underline">
    İstanbul genelindeki tüm hizmet bölgelerimiz →
  </a>
</section>
