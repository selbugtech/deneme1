---
import { byGroup } from '../data/services';

const services = byGroup('ana');
const tadilat = byGroup('tadilat');
const oda = byGroup('oda');
---

<section id="hizmetler" class="py-24 bg-[#F5EFE6]">
  <div class="max-w-6xl mx-auto px-6">

    <!-- Section header -->
    <div class="mb-16 reveal">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-px bg-gold"></span>
        <span class="text-xs tracking-[0.3em] uppercase text-gold font-medium">Hizmetlerimiz</span>
      </div>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-charcoal max-w-md leading-tight">
        Her Mekân İçin<br />Çözüm Üretiyoruz
      </h2>
    </div>

    <!-- Services grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((s, i) => (
        <a
          href={s.href}
          class={`bg-[#FAF6F1] px-10 py-8 group hover:bg-[#EDE5D8] transition-colors duration-300 reveal reveal-d${(i % 3) + 1} flex flex-col`}
        >
          <div class="text-gold mb-5 group-hover:scale-110 transition-transform duration-300 inline-block [&_svg]:w-10 [&_svg]:h-10" set:html={s.icon} />
          <h3 class="font-display text-xl font-semibold text-charcoal mb-3 group-hover:text-gold transition-colors">{s.title}</h3>
          <p class="text-muted text-sm leading-relaxed mb-5 flex-1">{s.desc}</p>
          <span class="text-sm text-gold/70 group-hover:text-gold transition-colors inline-flex items-center gap-2">
            Detaylar
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </span>
        </a>
      ))}
    </div>

    <!-- Popüler hizmetler: ana sayfadan ev/ofis/villa/mağaza ve oda sayfalarına doğrudan link -->
    <div class="mt-14 grid md:grid-cols-2 gap-10">
      <div>
        <h3 class="text-xs tracking-[0.25em] uppercase text-muted mb-4">Tadilat Hizmetleri</h3>
        <div class="flex flex-wrap gap-2">
          {tadilat.map(s => (
            <a href={s.href} class="px-3 py-1.5 border border-border text-charcoal text-xs font-medium hover:border-gold hover:text-gold transition-colors">{s.title}</a>
          ))}
        </div>
      </div>
      <div>
        <h3 class="text-xs tracking-[0.25em] uppercase text-muted mb-4">Oda Bazlı Çözümler</h3>
        <div class="flex flex-wrap gap-2">
          {oda.map(s => (
            <a href={s.href} class="px-3 py-1.5 border border-border text-charcoal text-xs font-medium hover:border-gold hover:text-gold transition-colors">{s.title}</a>
          ))}
        </div>
      </div>
    </div>

  </div>
</section>
