---
// Google puan şeridi — tıklanabilir, Google Haritalar kaydını yeni sekmede açar.
//
// DİKKAT: Bu bileşen bilerek JSON-LD (aggregateRating / Review) ÜRETMEZ.
// Google, bir işletmenin kendi hakkındaki puanını (self-serving aggregateRating)
// LocalBusiness zengin sonuçlarında kullanmıyor; ayrıca Google yorumlarının siteye
// kopyalanması yapısal veri kurallarına aykırı. Arama sonuçlarındaki yıldızlar
// Google İşletme Profili'nden gelir, siteden değil.
//
// Değerler elle güncellenir: src/config.ts → GOOGLE_RATING / GOOGLE_REVIEW_COUNT

import { GOOGLE_MAPS_URL, GOOGLE_RATING, GOOGLE_REVIEW_COUNT } from '../config';

interface Props {
  /**
   * band    — tam genişlik ayırıcı bant (ana sayfa, hero altı)
   * dark    — siyah kart (iletişim bölümü, tüm sayfalar)
   * compact — küçük kart, koyu zemin üstünde (projeler bölümü başlığı)
   * light   — açık zeminli kart
   */
  variant?: 'band' | 'dark' | 'compact' | 'light';
}

const { variant = 'light' } = Astro.props;

const isBand = variant === 'band';
const isDark = variant === 'dark';
const isCompact = variant === 'compact';

const STAR = 'M9.05 2.93c.3-.92 1.6-.92 1.9 0l1.47 4.53a1 1 0 00.95.69h4.76c.97 0 1.37 1.24.59 1.81l-3.85 2.8a1 1 0 00-.36 1.12l1.47 4.53c.3.92-.75 1.69-1.54 1.12l-3.85-2.8a1 1 0 00-1.18 0l-3.85 2.8c-.78.57-1.83-.2-1.53-1.12l1.47-4.53a1 1 0 00-.36-1.12l-3.85-2.8c-.79-.57-.38-1.81.58-1.81h4.76a1 1 0 00.95-.69L9.05 2.93z';

// Dış kabuk
const shell = isBand
  ? 'block w-full bg-[#FAF6F1] border-y border-border hover:bg-[#EDE5D8]'
  : isCompact
    ? 'inline-flex flex-col gap-2 border border-white/15 bg-white/5 px-5 py-4 hover:border-gold hover:bg-white/[0.08]'
    : isDark
      ? 'block border border-charcoal bg-charcoal hover:border-gold'
      : 'block border border-border bg-[#FAF6F1] hover:border-gold';

// İç sarmalayıcı — bant modunda içerik ortalanır ve max genişlikte tutulur
const inner = isBand
  ? 'max-w-6xl mx-auto px-6 py-7 flex flex-wrap items-center gap-x-8 gap-y-4'
  : 'px-6 py-5 flex flex-wrap items-center gap-x-6 gap-y-4';

const strong = isDark ? 'text-white' : 'text-charcoal';
const soft = isDark ? 'text-white/55' : 'text-muted';

const ariaLabel = `Google Haritalar'da Master İç Mimarlık — 5 üzerinden ${GOOGLE_RATING}, ${GOOGLE_REVIEW_COUNT} yorum`;
---

<a
  href={GOOGLE_MAPS_URL}
  target="_blank"
  rel="noopener noreferrer"
  class={`group transition-colors duration-200 ${shell}`}
  aria-label={ariaLabel}
>
  {isCompact ? (
    <>
      <div class="flex items-center gap-2.5">
        <svg class="w-5 h-5 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
          <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
          <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
          <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
        </svg>
        <span class="font-sans text-xl font-semibold leading-none tracking-tight tabular-nums text-white">{GOOGLE_RATING}</span>
        <div class="flex items-center gap-0.5" aria-hidden="true">
          {[1, 2, 3, 4, 5].map(() => (
            <svg class="w-3.5 h-3.5 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d={STAR}/></svg>
          ))}
        </div>
      </div>
      <span class="inline-flex items-center gap-1.5 text-xs text-white/55 group-hover:text-white/75 transition-colors">
        {GOOGLE_REVIEW_COUNT} Google yorumu
        <svg class="w-3 h-3 text-gold group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </span>
    </>
  ) : (
    <div class={inner}>

      <!-- Google G -->
      <svg class="w-7 h-7 shrink-0" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#4285F4" d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"/>
        <path fill="#34A853" d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"/>
        <path fill="#FBBC05" d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"/>
        <path fill="#EA4335" d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"/>
      </svg>

      <!-- Puan + yıldızlar -->
      <div class="flex items-center gap-3">
        <span class={`font-sans text-[2rem] font-semibold leading-none tracking-tight tabular-nums ${strong}`}>{GOOGLE_RATING}</span>
        <div class="flex items-center gap-0.5" aria-hidden="true">
          {[1, 2, 3, 4, 5].map(() => (
            <svg class="w-4 h-4 text-gold" fill="currentColor" viewBox="0 0 20 20"><path d={STAR}/></svg>
          ))}
        </div>
      </div>

      <!-- Yorum sayısı -->
      <div class="flex-1 min-w-[10rem]">
        <p class={`text-sm font-medium ${strong}`}>{GOOGLE_REVIEW_COUNT} Google yorumu</p>
        <p class={`text-xs mt-0.5 ${soft}`}>Müşterilerimizin değerlendirmeleri</p>
      </div>

      <!-- CTA -->
      <span class="inline-flex items-center gap-2 text-sm text-gold font-medium shrink-0">
        Google Haritalar'da görün
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </span>

    </div>
  )}
</a>
