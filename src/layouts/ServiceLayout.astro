---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import Projects from '../components/Projects.astro';
import Contact from '../components/Contact.astro';
import { CANONICAL_BASE, TEL_URL, WHATSAPP_URL_PROJECT, WHATSAPP_URL_SERVICE } from '../config';
import { optimizedImageW, srcsetImage } from '../lib/cloudinary';
import { byGroup, getService } from '../data/services';

interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  h1: string;
  eyebrow?: string;
  lead: string;
  breadcrumb: { label: string; href?: string }[];
  structuredData?: object | object[];
  heroImage?: string;
  ogImage?: string;
  /** /iletisim gibi kendi büyük haritası olan sayfalarda alttaki küçük harita gizlenir */
  contactShowMap?: boolean;
}

// Not: eskiden bir `expandedByDefault` seçeneği vardı; gövde 600px'e kırpılıp
// "Detaylı Bilgiyi Gör" düğmesinin arkasına alınıyordu. Bu sayfaların gövdesi
// 2.500–3.000px: bölge notları, süreç, SSS, proje referansları ve ilçeler arası
// linklerin tamamı fade'in altında kalıyordu — yani sayfaları şablon olmaktan
// çıkaran içeriğin tamamı. 23 sayfa zaten tek tek seçenekten çıkmıştı, hiçbiri
// kırpmayı istemiyordu; seçenek tamamen kaldırıldı. DistrictFAQ zaten <details>
// ile aşamalı gösterim yapıyor, ikinci bir katmana gerek yok.
const {
  title, description, canonicalUrl, h1,
  eyebrow = 'Hizmetlerimiz', lead,
  breadcrumb, structuredData,
  heroImage, ogImage,
  contactShowMap = true,
} = Astro.props;

const currentSlug = canonicalUrl.split('/').pop() ?? '';
const current = getService(currentSlug);

// Önce aynı gruptaki hizmetler, yetmezse ana hizmetlerle tamamla
const relatedServices = [
  ...(current ? byGroup(current.group) : []),
  ...byGroup('ana'),
]
  .filter(s => s.slug !== currentSlug)
  .filter((s, i, arr) => arr.findIndex(x => x.slug === s.slug) === i)
  .slice(0, 3);

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumb.map((item, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": item.label,
    ...(item.href ? { "item": item.href } : {})
  }))
};

const allSchema = [
  breadcrumbSchema,
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [])
];
---

<Layout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage ?? heroImage}
  structuredData={allSchema}
>
  <Header />

  <main class="bg-[#F5EFE6] min-h-screen">

    <!-- Hero -->
    <section class="relative w-full overflow-hidden min-h-[88vh] md:min-h-[85vh] flex items-end">
      {heroImage ? (
        <img
          src={heroImage.startsWith('http') ? heroImage : optimizedImageW(heroImage, 1600)}
          srcset={heroImage.startsWith('http') ? undefined : srcsetImage(heroImage, [800, 1200, 1600, 2000])}
          sizes="100vw"
          width="1600"
          height="900"
          alt={h1}
          fetchpriority="high"
          decoding="async"
          class="absolute inset-0 w-full h-full object-cover object-center"
        />
      ) : (
        <div class="absolute inset-0 bg-charcoal"></div>
      )}
      <div class="absolute inset-0 bg-charcoal/75"></div>
      <div class="absolute bottom-0 left-0 right-0 h-28 bg-gradient-to-t from-charcoal/35 to-transparent"></div>

      <!-- Content -->
      <div class="relative z-10 w-full max-w-6xl mx-auto px-6 pt-40 pb-16">
        <div class="max-w-2xl">

          <!-- Breadcrumb -->
          <nav class="flex items-center gap-2 text-xs flex-wrap mb-8" aria-label="Breadcrumb">
            {breadcrumb.map((item, i) => (
              <>
                {i > 0 && <span class="text-white/20">/</span>}
                {item.href
                  ? <a href={item.href} class="text-white/50 hover:text-gold transition-colors">{item.label}</a>
                  : <span class="text-white/70">{item.label}</span>
                }
              </>
            ))}
          </nav>

          <div class="flex items-center gap-3 mb-7">
            <span class="w-8 h-px bg-gold"></span>
            <span class="text-[10px] sm:text-xs tracking-[0.2em] sm:tracking-[0.3em] uppercase text-gold font-medium">{eyebrow}</span>
          </div>

          <h1 class="font-display text-[2.2rem] sm:text-5xl md:text-6xl lg:text-[4rem] font-bold leading-[1.05] text-white mb-6">{h1}</h1>

          <p class="text-white/85 text-base sm:text-lg leading-relaxed max-w-xl mb-8">{lead}</p>

          <!-- Free site visit badge -->
          <div class="mb-5">
            <span class="inline-flex items-center gap-3 bg-[#faf6f1] text-charcoal px-7 py-3.5 sm:px-8 sm:py-4 text-base sm:text-lg tracking-[0.2em] uppercase font-bold shadow-lg shadow-black/30">
              <span class="w-2.5 h-2.5 rounded-full bg-gold"></span>
              Ücretsiz Keşif
            </span>
          </div>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-4 mb-10">
            <a
              href={WHATSAPP_URL_SERVICE}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3 bg-[#25D366] text-white px-8 py-4 text-sm font-semibold tracking-wide hover:bg-[#1EBD5A] transition-colors duration-200 shadow-lg shadow-green-900/40"
            >
              <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              Ücretsiz Keşif Randevusu
            </a>
            <a
              href={TEL_URL}
              class="inline-flex items-center justify-center gap-3 bg-white/10 backdrop-blur-sm border border-white/25 text-white px-8 py-4 text-sm font-semibold tracking-wide hover:bg-white/20 transition-colors duration-200"
            >
              <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 7V5z"/>
              </svg>
              0533 039 15 65
            </a>
          </div>

          <!-- Info strip -->
          <div class="flex flex-wrap items-center gap-6 pt-6 border-t border-white/15">
            <div>
              <p class="text-[10px] tracking-[0.25em] uppercase text-white/45 mb-1">Telefon / WhatsApp</p>
              <a href={TEL_URL} class="text-white font-semibold hover:text-gold transition-colors">0533 039 15 65</a>
            </div>
            <div class="w-px h-8 bg-white/15"></div>
            <div>
              <p class="text-[10px] tracking-[0.25em] uppercase text-white/45 mb-1">Hizmet Bölgesi</p>
              <p class="text-white font-semibold">İstanbul &amp; Çevre İller</p>
            </div>
            <div class="w-px h-8 bg-white/15 hidden sm:block"></div>
            <div class="hidden sm:block">
              <p class="text-[10px] tracking-[0.25em] uppercase text-white/45 mb-1">Ücretsiz Keşif</p>
              <p class="text-white font-semibold">Randevu Alın</p>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Sayfaya özel içerik -->
    <div class="max-w-6xl mx-auto px-6 py-16">
      <div class="prose prose-charcoal max-w-none service-content">
        <slot />
      </div>
    </div>

    <!-- Related services -->
    <div class="border-t border-border py-16">
      <div class="max-w-6xl mx-auto px-6">
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-3">
            <span class="w-8 h-px bg-gold"></span>
            <span class="text-xs tracking-[0.3em] uppercase text-gold font-medium">Diğer Hizmetler</span>
          </div>
          <a href="/hizmetler" class="text-xs text-muted hover:text-gold transition-colors">Tümünü Gör →</a>
        </div>
        <div class="grid md:grid-cols-3 gap-6">
          {relatedServices.map(s => (
            <a href={s.href} class="group block border border-border hover:border-gold transition-colors duration-200">
              <div class="overflow-hidden">
                <img src={s.image} alt={s.title} loading="lazy" decoding="async" class="w-full h-44 object-cover group-hover:scale-105 transition-transform duration-500" />
              </div>
              <div class="p-5">
                {s.keyword && <p class="text-[10px] tracking-[0.25em] uppercase text-gold mb-2">{s.keyword}</p>}
                <h3 class="font-display text-base font-bold text-charcoal group-hover:text-gold transition-colors mb-1">{s.title}</h3>
                <p class="text-muted text-xs leading-relaxed">{s.shortDesc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Projects (social proof) — içerikten sonra, dönüşüm bloğunun hemen öncesinde -->
    <Projects />

    <!-- Contact section (full) -->
    <Contact showMap={contactShowMap} />

  </main>

  <Footer />
  <WhatsAppFloat />
</Layout>

<style is:global>
  .service-content h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #1C1C1A;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .service-content h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #1C1C1A;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  .service-content p {
    color: #787874;
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }
  .service-content ul {
    color: #787874;
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }
  .service-content ul li {
    margin-bottom: 0.5rem;
    line-height: 1.7;
  }
  .service-content strong {
    color: #1C1C1A;
    font-weight: 600;
  }
  .service-content a {
    color: #A8894A;
    text-decoration: underline;
  }
</style>

