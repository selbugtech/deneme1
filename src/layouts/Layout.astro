---
import { SEO } from 'astro-seo';
import { CANONICAL_BASE, OG_IMAGE_PATH, SITE_NAME, SITE_PHONE, EMAIL, GOOGLE_MAPS_URL, SAME_AS } from '../config';
import { ogImageUrl } from '../lib/images';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: object | object[];
  lcpImage?: string;
  lcpImageSrcset?: string;
  lcpImageSizes?: string;
}

const {
  // Varsayılan başlık/açıklama yalnızca ana sayfada kullanılıyor (diğer tüm sayfalar
  // kendi değerini geçiyor). Eski başlık markayla başlayıp 75 karakterdi: arama
  // sonucunda "| İstanbul" kesiliyordu ve markasız aramada en değerli ilk kelimeler
  // marka adına harcanıyordu. Yeni hali ana sayfa H1'iyle aynı; marka eki aşağıda
  // otomatik ekleniyor → "İstanbul İç Mimarlık ve Ev Yenileme | Master İç Mimarlık".
  title: rawTitle = 'İstanbul İç Mimarlık ve Ev Yenileme',
  description = 'İstanbul\'da iç mimarlık, anahtar teslim ev ve villa yenileme, mağaza ve ofis tadilatı. Her ilçede ücretsiz keşif ve 3D tasarım. 0533 039 15 65',
  canonicalUrl,
  ogImage = OG_IMAGE_PATH,
  ogType = 'website',
  structuredData,
  lcpImage,
  lcpImageSrcset,
  lcpImageSizes,
} = Astro.props;

// Marka eki koşullu. Sayfaların büyük çoğunluğu başlığı markasız geçiyor, ama
// " | Master İç Mimarlık" 21 karakter: düz bir şablon başlıkların önemli kısmını
// Google'ın arama sonucunda kestiği ~65 karakterin üstüne taşırdı. Eki yalnızca
// sığdığı yerde ekliyoruz — anahtar kelimeyi kestirmektense marka eksik kalsın.
const BRAND_SUFFIX = ` | ${SITE_NAME}`;
const title = rawTitle.includes(SITE_NAME) || rawTitle.length + BRAND_SUFFIX.length > 65
  ? rawTitle
  : rawTitle + BRAND_SUFFIX;

const canonical = canonicalUrl ?? `${CANONICAL_BASE}${Astro.url.pathname}`;

// og:image HER ZAMAN mutlak olmalı. Çağıranlar üç şekilde geçiyor: mutlak http(s)
// URL, site-göreli /images/... yolu, ya da hiç. ServiceLayout ve BlogPost
// `ogImage ?? heroImage` forward ettiği için 28 sayfa çıplak bir /images/... yolu
// geçiriyordu — Facebook/X/WhatsApp göreli URL çözmez. Tek nokta burası:
// ServiceLayout/BlogPost'ta ayrıca mutlaklaştırma YAPILMAYACAK, yoksa
// görsel iki kez dönüştürülür.
const ogImageAbs = ogImageUrl(ogImage);

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${CANONICAL_BASE}/#website`,
  "url": `${CANONICAL_BASE}/`,
  "name": SITE_NAME,
  "description": "İstanbul'da anahtar teslim ev yenileme, villa yenileme, mağaza ve ofis yenileme hizmetleri.",
  "inLanguage": "tr-TR",
  "publisher": { "@id": `${CANONICAL_BASE}/#organization` }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${CANONICAL_BASE}/#organization`,
  "name": SITE_NAME,
  "url": `${CANONICAL_BASE}/`,
  "logo": {
    "@type": "ImageObject",
    "url": `${CANONICAL_BASE}/icon-512.png`,
    "contentUrl": `${CANONICAL_BASE}/icon-512.png`,
    "width": 512,
    "height": 512
  },
  "email": EMAIL,
  "sameAs": SAME_AS,
  "foundingLocation": { "@type": "Place", "name": "İstanbul, Türkiye" },
  "knowsAbout": [
    "İç mimari tasarım",
    "Anahtar teslim yenileme",
    "Konut ve villa tadilatı",
    "Ticari mekan iç mimarlığı",
    "3D görselleştirme",
    "Şantiye yönetimi"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": SITE_PHONE,
    "email": EMAIL,
    "contactType": "customer service",
    "availableLanguage": "Turkish"
  }
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "InteriorDesigner",
  "@id": `${CANONICAL_BASE}/#business`,
  "name": SITE_NAME,
  "url": `${CANONICAL_BASE}/`,
  "logo": `${CANONICAL_BASE}/icon-512.png`,
  "image": ogImageAbs,
  "description": "İstanbul'da anahtar teslim ev yenileme, villa yenileme, mağaza ve ofis yenileme hizmetleri.",
  "telephone": SITE_PHONE,
  "email": EMAIL,
  "hasMap": GOOGLE_MAPS_URL,
  "sameAs": SAME_AS,
  "parentOrganization": { "@id": `${CANONICAL_BASE}/#organization` },
  "openingHoursSpecification": [
    // 7/24. Google yapisal veride tum gun acik icin 00:00-23:59 bekliyor.
    // Google Isletme Profili de "24 saat acik" gosteriyor; ikisi tutarli olmali.
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Akasya A Kule, No: 25/A, Çeçen Sok., Acıbadem",
    "addressLocality": "Üsküdar",
    "addressRegion": "İstanbul",
    "postalCode": "34660",
    "addressCountry": "TR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 41.001739,
    "longitude": 29.0543556
  },
  "areaServed": [
    { "@type": "City", "name": "İstanbul" },
    { "@type": "AdministrativeArea", "name": "İstanbul ili" }
  ]
  // Not: aggregateRating / review alanları bilerek yok. Google, işletmenin kendisi
  // hakkındaki puanı (self-serving) LocalBusiness zengin sonuçlarında kullanmıyor ve
  // Google yorumlarının siteye kopyalanması yapısal veri kurallarına aykırı.
};

const allStructuredData = [
  websiteSchema,
  organizationSchema,
  localBusinessSchema,
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [])
];
---

<!DOCTYPE html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <SEO
      title={title}
      description={description}
      canonical={canonical}
      openGraph={{
        basic: {
          title: title,
          type: ogType,
          image: ogImageAbs,
          url: canonical,
        },
        optional: {
          description: description,
          locale: 'tr_TR',
          siteName: SITE_NAME,
        },
        image: {
          width: 1200,
          height: 630,
          alt: `${SITE_NAME} — İstanbul İç Mimarlık ve Ev Yenileme`,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title: title,
        description: description,
        image: ogImageAbs,
      }}
      extend={{
        meta: [
          { name: 'author', content: SITE_NAME },
        ],
      }}
    />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="48x48" href="/icon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />


    <!-- LCP image preload — responsive (mobilde küçük, masaüstünde büyük boyut) -->
    {lcpImage && (
      <link
        rel="preload"
        as="image"
        href={lcpImage}
        imagesrcset={lcpImageSrcset}
        imagesizes={lcpImageSizes ?? '100vw'}
        fetchpriority="high"
      />
    )}

    <!-- Fontlar kendi sunucumuzdan (değişken woff2, latin + latin-ext = Türkçe karakterler).
         Google Fonts zinciri (DNS + TLS + css + woff2) kalktı. Yalnızca latin dosyaları preload. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/playfair-latin.woff2" crossorigin />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(allStructuredData).replace(/<\//g, '<\\/')} />

    {/* GTM yorumda: kullanıcı kararı (aktif reklam yok, veriye bakan yok). Yeniden açmak için aşağıdaki bloğu geri alın.
    <!-- Google Tag Manager — idle callback ile ertele (FCP/LCP engelleme yok) -->
    <script is:inline>
      (function(){
        function _loadGTM(){
          (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
          j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
          'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
          })(window,document,'script','dataLayer','GTM-KKHH7KWV');
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(_loadGTM, { timeout: 3000 });
        } else {
          setTimeout(_loadGTM, 2000);
        }
      })();
    </script>
    <!-- End Google Tag Manager -->
    */}
  </head>
  <body class="bg-warm-white text-charcoal font-sans antialiased">
    {/* GTM noscript yorumda (yukarıya bakın)
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KKHH7KWV"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    */}

    <slot />

    {/* GA4 + Ads takip betiği YORUMDA (kullanıcı kararı: veriye bakan yok, hız kazancı).
       Yeniden açmak için bu yorum bloğunu kaldırın. Search Console / sıralama bundan etkilenmez.
    <script>
      // GA4 (Ads yorumda) — tarayıcı boşta kaldığında yükle (FCP/LCP engelleme yok)
      function _loadTracking() {
        // Google Ads (gtag.js) — YORUMDA: sitede aktif reklam yok (kullanıcı kararı).
        // Yeniden açmak için aşağıdaki bloğun yorumunu kaldırın.
        // var s = document.createElement('script');
        // s.async = true;
        // s.src = 'https://www.googletagmanager.com/gtag/js?id=AW-18023437304';
        // s.onload = function() {
        // window.dataLayer = window.dataLayer || [];
        // function gtag(){dataLayer.push(arguments);}
        // window.gtag = gtag;
        // gtag('js', new Date());
        // gtag('config', 'AW-18023437304');
        // };
        // document.head.appendChild(s);

        // Google Analytics GA4 (G-G7QH86RT87)
        var ga = document.createElement('script');
        ga.async = true;
        ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-G7QH86RT87';
        ga.onload = function() {
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = window.gtag || gtag;
          gtag('js', new Date());
          gtag('config', 'G-G7QH86RT87');
        };
        document.head.appendChild(ga);
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(_loadTracking, { timeout: 3000 });
      } else {
        setTimeout(_loadTracking, 3000);
      }
    </script>
    */}

    <script>
      // Scroll reveal — requestIdleCallback ile ertele (TBT azalır)
      function _initReveal() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
              }
            });
          },
          { threshold: 0.1 }
        );
        document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
      }
      if ('requestIdleCallback' in window) {
        // timeout: ana thread GTM/gtag ile meşgulse hero metni (opacity 0) geç görünmesin
        requestIdleCallback(_initReveal, { timeout: 400 });
      } else {
        setTimeout(_initReveal, 0);
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face { font-family: 'Inter'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/fonts/inter-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
  @font-face { font-family: 'Inter'; font-style: normal; font-weight: 400 600; font-display: swap; src: url(/fonts/inter-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }
  @font-face { font-family: 'Playfair Display'; font-style: normal; font-weight: 400 700; font-display: swap; src: url(/fonts/playfair-latin-ext.woff2) format('woff2'); unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF; }
  @font-face { font-family: 'Playfair Display'; font-style: normal; font-weight: 400 700; font-display: swap; src: url(/fonts/playfair-latin.woff2) format('woff2'); unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD; }

  html { scroll-behavior: auto; overflow-x: hidden; }
  body { overflow-x: hidden; }

  /* Kontrast: açık zeminde küçük altın yazı (#A8894A, 3.2:1) yetersiz. Koyu altın yalnızca
     açık alanlarda; koyu bölgeler (.dark-zone hero'lar, .bg-charcoal) bu kuralın dışında. */
  main .text-gold:not(.dark-zone *, .bg-charcoal *, [class~="bg-[#111110]"] *, [class~="bg-gold"] *) { color: #7f6329; }
  /* Metin içi linkler yalnızca renkle ayırt edilmesin (link-in-text-block) */
  main p a.text-gold, main li a.text-gold { text-decoration: underline; text-underline-offset: 2px; }
  /* text-muted koyu zeminde (açık zemin için koyulaştırıldı) */
  .bg-charcoal .text-muted, [class~="bg-[#111110]"] .text-muted, .dark-zone .text-muted { color: #9a9a94; }

  /* Tutarlı klavye odak göstergesi — tüm etkileşimli öğeler için */
  :focus-visible {
    outline: 2px solid #C9A35D;
    outline-offset: 2px;
    border-radius: 2px;
  }
  :focus:not(:focus-visible) { outline: none; }

  @media (prefers-reduced-motion: no-preference) {
    html { scroll-behavior: smooth; }
  }

  /* Reveal animasyonu — azaltılmış hareket tercih etmeyenler için */
  @media (prefers-reduced-motion: no-preference) {
    .reveal {
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.65s ease, transform 0.65s ease;
    }
    .reveal-d1 { transition-delay: 0.1s; }
    .reveal-d2 { transition-delay: 0.2s; }
    .reveal-d3 { transition-delay: 0.3s; }
    .reveal-d4 { transition-delay: 0.4s; }
    .reveal-d5 { transition-delay: 0.5s; }
  }

  /* Azaltılmış hareket tercih edenler: animasyon yok, direkt göster */
  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1; transform: none; }
  }

  .reveal.is-visible { opacity: 1; transform: translateY(0); }

  /* Hero (ilk ekran): .reveal JS'e bağlıydı ve opacity 0 ile başlıyordu → LCP gecikiyordu.
     Burada yalnızca yukarı kayma var, metin hemen boyanır. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-rise { animation: hero-rise 0.7s ease both; }
    .hero-rise.d1 { animation-delay: 0.08s; } .hero-rise.d2 { animation-delay: 0.16s; }
    .hero-rise.d3 { animation-delay: 0.24s; } .hero-rise.d4 { animation-delay: 0.32s; }
  }
  @keyframes hero-rise { from { transform: translateY(18px); } to { transform: none; } }
</style>
